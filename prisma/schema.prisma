// Profissionaliza Mais Brasil — Schema Prisma Completo
// Banco: PostgreSQL (Supabase)
// Atualizado: 2026-04-13

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN // PMB owner — full access
  PMB_SALES // Vendedor de curso (vendas diretas vitrine PMB B2C, cupom ate 50%)
  PMB_SALES_MGR // Gerente de vendas — chefia dos vendedores de revenda (ve o time)
  PMB_REVENDA_SALES // Vendedor de revenda (B2B): trabalha leads e fecha unidades
  PMB_RESELLER_DIRECTOR // Diretor de unidades — o gerente sem recorte de carteira (ve a rede toda)
  PMB_RESELLER_MGR // Gerente de unidades / suporte (ve as unidades atribuidas)
  PMB_FINANCEIRO // Financeiro — ajusta comissoes, marca pagamentos e anexa comprovante
  PMB_DESIGNER // Designer — gerencia o banco de artes de divulgacao (/admin/artes)
  RESELLER // Dono ou consultor de tenant
  STUDENT // Aluno acessa /aluno com matriculas e pagamentos
}

enum TenantStatus {
  PENDING // Aguardando primeiro pagamento
  ACTIVE // Ativo e operante
  SUSPENDED // Suspenso por inadimplencia
  CANCELLED // Cancelado definitivamente
}

enum BillingMode {
  AUTO // Sistema bloqueia aluno automaticamente
  MANUAL // Revendedor decide quando bloquear
}

enum StudentStatus {
  ATIVO
  INATIVO
  BLOQUEADO
  DEVEDOR
  FORMADO
  INTERESSADO
}

enum ApostilaStatus {
  LIBERADA
  BLOQUEADA
}

enum EnrollmentStatus {
  PENDING // Aguardando pagamento
  ACTIVE // Matricula ativa
  SUSPENDED // Suspenso por inadimplencia
  CANCELLED // Cancelado
  COMPLETED // Curso concluido
}

enum PaymentType {
  ONE_TIME // Pagamento unico
  MONTHLY // Assinatura mensal
  BOLETO_INSTALLMENT // Carne: N boletos com vencimentos mensais (venda direta da revenda e vitrine PMB)
  CARD_INSTALLMENT // Parcelado no cartao via Asaas /installments (vitrine PMB)
}

// Status de cada parcela (boleto) de um carne de venda direta. Ver
// src/lib/installments/ e o model BoletoInstallment.
enum BoletoInstallmentStatus {
  SCHEDULED // Agendada — boleto ainda nao emitido (MP: emite ~7 dias antes do vencimento)
  GENERATED // Boleto emitido e disponivel para o aluno
  PAID // Parcela paga (webhook confirmou)
  OVERDUE // Vencida sem pagamento
  CANCELLED // Parcela cancelada (ex.: matricula cancelada)
}

// Escopo onde o pagamento parcelado/mensalidade da unidade vale.
enum MonthlyScope {
  DIRECT_ONLY // So venda direta/manual (revendedor cria a venda)
  DIRECT_AND_VITRINE // Tambem a vitrine publica (compra self-service do lead)
}

/// Escopo de cursos que uma assinatura libera. ALL e CATEGORY sao DINAMICOS:
/// o conjunto e resolvido por query no momento do acesso, nunca materializado —
/// curso novo na categoria entra sozinho, sem tocar no plano.
enum SubscriptionScope {
  ALL // todo o catalogo vendavel da vitrine
  CATEGORY // uma ou mais categorias (Category/CourseCategory)
  PACKAGE // os cursos de um CoursePackage
  COURSES // lista fixa de cursos
}

/// Periodicidade da assinatura.
///
/// LIFETIME NAO e uma recorrencia: e uma cobranca UNICA que da acesso
/// permanente ao escopo do plano. Ver `src/lib/subscriptions/interval.ts` —
/// tratar o vitalicio como "ciclo muito longo" faria o gateway cobrar de novo
/// no futuro e a varredura de carencia cancelar quem ja pagou.
enum SubscriptionInterval {
  MONTHLY // mensal
  QUARTERLY // trimestral
  SEMIANNUAL // semestral
  ANNUAL // anual
  LIFETIME // vitalicio — pagamento unico, sem renovacao
}

enum SubscriptionStatus {
  PENDING // criada, aguardando o 1o pagamento
  ACTIVE // em dia
  PAST_DUE // atrasada, dentro da carencia (ainda da acesso)
  CANCELLED // encerrada (pelo aluno, pela carencia ou por estorno)
  EXPIRED // ciclo terminou sem renovacao
}

enum CourseVisibility {
  ALL // disponivel para todos os tenants ativos
  ALLOWLIST // apenas os tenants em allowedTenantIds
  DENYLIST // todos exceto os tenants em blockedTenantIds
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  REFUNDED
  CANCELLED
  IN_PROCESS
  CHARGED_BACK
}

enum DiscountType {
  PERCENTAGE // Desconto percentual (ex: 20%)
  FIXED // Desconto fixo em reais (ex: R$50)
}

enum WebhookSource {
  ASAAS
  MERCADO_PAGO
  LMS
}

enum PaymentGateway {
  MP
  ASAAS
}

// ============================================================
// USUARIOS E AUTENTICACAO
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String    @map("password_hash")
  role          UserRole  @default(RESELLER)
  status        String    @default("ATIVO") // ATIVO / INATIVO / PENDING_INVITE
  phone         String?
  // CPF do titular (11 digitos, sem mascara) — identificador ALTERNATIVO de
  // login (o primario segue sendo email). Unique para o login por CPF ser
  // deterministico; nullable porque contas antigas nao coletavam o dado.
  cpf           String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  lastActiveAt  DateTime? @map("last_active_at")

  // Cap individual de desconto (%) do vendedor PMB_SALES nas vendas diretas da
  // vitrine PMB (criacao e aplicacao de cupom). null = padrao da role (50).
  // Definido pelo SUPER_ADMIN em /admin/equipe. Ver src/lib/coupons/sales-cap.ts
  maxDiscount Int? @map("max_discount")

  // Ajustes finos por pessoa sobre o preset do papel (equipe interna PMB).
  // Permissoes fora do catalogo sao ignoradas na resolucao; SUPER_EXCLUSIVE
  // nunca e concedida por extraPermissions. Fonte da verdade dos presets:
  // src/lib/auth/admin-permissions.ts. Nao se aplica a RESELLER/STUDENT — o
  // ajuste fino do membro de unidade vive em TenantMember.
  extraPermissions   String[] @default([]) @map("extra_permissions")
  revokedPermissions String[] @default([]) @map("revoked_permissions")

  // Relacao: se for RESELLER, qual tenant e dono
  tenantId String? @unique @map("tenant_id")
  tenant   Tenant? @relation("TenantOwner", fields: [tenantId], references: [id])

  // Memberships em tenants (para multiplos admins)
  tenantMemberships TenantMember[]

  // Tenants gerenciados (PMB_RESELLER_MGR como account manager / suporte)
  managedTenants Tenant[] @relation("AccountManagerTenants")

  // Unidades cuja venda (revenda) e atribuida a este usuario (PMB_REVENDA_SALES)
  salesTenants Tenant[] @relation("SalesUserTenants")

  // Hierarquia comercial: gerente de vendas (PMB_SALES_MGR) deste vendedor de
  // revenda. salesTeam = vendedores subordinados a este gerente.
  salesManagerId String? @map("sales_manager_id")
  salesManager   User?   @relation("SalesTeam", fields: [salesManagerId], references: [id])
  salesTeam      User[]  @relation("SalesTeam")

  // Leads de revenda (B2B) atribuidos a este usuario (PMB_REVENDA_SALES)
  ownedLeads Lead[] @relation("LeadOwner")

  // Cupons criados por este usuario (auditoria + cap por papel)
  createdCoupons Coupon[] @relation("CreatedCoupons")

  // Vendas diretas geradas por este usuario (PMB_SALES / consultor)
  soldEnrollments Enrollment[] @relation("SoldEnrollments")
  soldPayments    Payment[]    @relation("SoldPayments")

  // Notas de suporte escritas por este usuario
  supportNotes TenantSupportNote[] @relation("SupportNotes")

  // Notas internas escritas sobre alunos por este usuario
  studentNotes StudentNote[] @relation("StudentNotes")

  // Chaves da API de parceiros (/api/v1) criadas por este usuario
  createdApiKeys ApiKey[] @relation("CreatedApiKeys")

  // TenantPayments / ReferralPayouts marcados manualmente como pagos por este admin
  markedTenantPayments   TenantPayment[]  @relation("MarkedTenantPayments")
  refundedTenantPayments TenantPayment[]  @relation("RefundedTenantPayments")
  markedReferralPayouts  ReferralPayout[] @relation("MarkedReferralPayouts")
  // Saques cujo comprovante de pagamento foi anexado por este usuario (Financeiro)
  uploadedReferralProofs ReferralPayout[] @relation("UploadedReferralProofs")

  // Progresso assistido nos treinamentos (Universidade PMB)
  trainingProgress TrainingProgress[]

  // Reset password
  resetToken        String?   @unique @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")

  // Troca obrigatória de senha no primeiro acesso
  mustChangePassword Boolean @default(false) @map("must_change_password")

  // Tutorial guiado de primeiro acesso (painel revendedor/consultor).
  // NULL = ainda não concluiu; data = concluiu/pulou. Roteiro escolhido
  // por TenantMember.role (owner vs consultant) em runtime.
  // LEGADO: cobria só o tour de visão geral (sidebar). Mantido para
  // compatibilidade — se preenchido, semeia "painel.overview" em dismissedTours.
  onboardingTourCompletedAt DateTime? @map("onboarding_tour_completed_at")

  // Tours guiados (driver.js) já vistos/dispensados por este usuário. Cada
  // página/função tem um tour com id estável (ex.: "painel.cursos"); o id entra
  // aqui quando o tour é fechado, para não auto-reabrir. Ver src/lib/tours/.
  dismissedTours String[] @default([]) @map("dismissed_tours")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([resetToken])
  @@index([salesManagerId])
  @@map("users")
}

// ============================================================
// MEMBROS DO TENANT (para multiplos admins no futuro)
// ============================================================

model TenantMember {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId   String @map("user_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Papel do membro dentro da unidade: manager | consultant | support | finance.
  // O dono NAO tem TenantMember (e o User com tenantId apontando pro tenant) e
  // recebe o preset "owner". Valores legados/desconhecidos caem no preset mais
  // restrito (consultant) — ver normalizeMemberRole em lib/auth/painel-permissions.
  role String @default("consultant")

  // Ajustes finos por pessoa sobre o preset do papel. Permissoes fora do
  // catalogo sao ignoradas na resolucao; OWNER_EXCLUSIVE nunca e concedida por
  // extraPermissions. Fonte da verdade: src/lib/auth/painel-permissions.ts.
  extraPermissions   String[] @default([]) @map("extra_permissions")
  revokedPermissions String[] @default([]) @map("revoked_permissions")

  maxDiscount Int?   @map("max_discount") // % cap para cupons (vendedor/gerente)
  status      String @default("ATIVO")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, userId])
  // Listagem da equipe e roteamento de notificacao filtram por (tenant, papel).
  @@index([tenantId, role])
  @@map("tenant_members")
}

// ============================================================
// TENANTS (REVENDEDORES)
// ============================================================

model Tenant {
  id   String @id @default(cuid())
  name String // Nome do revendedor / empresa
  slug String @unique // Subdominio: slug.profissionalizamaisbrasil.com.br

  // Dominio custom
  customDomain   String? @unique @map("custom_domain") // ex: cursosjoao.com.br
  domainVerified Boolean @default(false) @map("domain_verified")

  // Personalizacao da vitrine
  logoUrl        String? @map("logo_url")
  // Icone da aba do navegador / atalho do PWA. Opcional: sem favicon propria a
  // vitrine cai na logoUrl (comportamento historico). Ver lib/seo/tenant-metadata.
  faviconUrl     String? @map("favicon_url")
  primaryColor   String  @default("#2563eb") @map("primary_color") // Azul padrao
  secondaryColor String  @default("#1e40af") @map("secondary_color")
  bannerUrl      String? @map("banner_url")
  tagline        String? // Frase curta da vitrine
  description    String? // Descricao longa
  whatsapp       String? // Whatsapp para contato

  // Botao flutuante de WhatsApp na vitrine (opcional). Quando habilitado, exibe
  // um FAB fixo (canto inferior direito/esquerdo) que abre o wa.me do numero
  // `whatsapp` acima ja com a mensagem pre-configurada. So aparece se `whatsapp`
  // for um numero com DDD valido — celular, fixo OU 0800, todos geram link (o
  // WhatsApp Business aceita linha fixa e toll-free). Ver `whatsappIntlNumber`.
  whatsappFloatEnabled Boolean @default(false) @map("whatsapp_float_enabled")
  whatsappFloatSide    String  @default("right") @map("whatsapp_float_side") // "right" | "left"
  whatsappFloatMessage String? @map("whatsapp_float_message") // Mensagem pre-preenchida (?text=)

  instagram    String?
  facebook     String?
  youtube      String?
  tiktok       String?
  supportEmail String? @map("support_email") // E-mail de atendimento exibido no rodape da vitrine
  supportHours String? @map("support_hours") // Horario de atendimento exibido no rodape e na barra de beneficios da vitrine

  // Status e config
  status      TenantStatus @default(PENDING)
  billingMode BillingMode  @default(AUTO) @map("billing_mode")
  planValue   Decimal      @map("plan_value") @db.Decimal(10, 2) // Valor da mensalidade

  // Pixels de rastreamento da vitrine (validados por src/lib/tracking/schema.ts).
  // Disparam SOMENTE apos consentimento LGPD. Migration 20260608_tracking_pixels.
  trackingPixels Json? @map("tracking_pixels")

  // Politica de cancelamento (flexivel, definida individualmente pelo admin)
  cancellationPolicy Json? @map("cancellation_policy")
  // Exemplo: { gracePeriodDays: 15, keepStudentsActive: true, notifyStudents: true }

  // Integracao Asaas (mensalidade do revendedor)
  asaasCustomerId     String? @unique @map("asaas_customer_id") // cus_xxxx
  asaasSubscriptionId String? @unique @map("asaas_subscription_id") // sub_xxxx — assinatura regular (valor cheio)

  // Promocao: as N primeiras mensalidades saem por uma subscription promo
  // (maxPayments=N) com promoValue; a regular (planValue) assume no mes N.
  asaasPromoSubscriptionId String?  @unique @map("asaas_promo_subscription_id") // sub_xxxx — assinatura promocional
  promoValue               Decimal? @map("promo_value") @db.Decimal(10, 2) // Valor das primeiras mensalidades
  promoMonths              Int?     @map("promo_months") // Quantidade de mensalidades no valor promo

  // Parcelamento da PRIMEIRA mensalidade no cartao de credito. O admin define
  // o teto na criacao; a revenda escolhe de 1x ate este valor no checkout.
  // 1 = a vista (sem parcelamento). So vale para a 1a mensalidade.
  firstPaymentMaxInstallments Int @default(1) @map("first_payment_max_installments")

  // Parcelamento no cartao das mensalidades SEGUINTES (unidade ja ativada).
  // Diferente de firstPaymentMaxInstallments, que so vale para a 1a mensalidade:
  // este e o teto de qualquer cobranca em aberto. null => usa o padrao global
  // SystemSettings.tenantMonthlyMaxInstallments. Resolucao unica em
  // src/lib/tenant-billing/installments.ts — nunca reimplementar a escolha.
  monthlyMaxInstallments Int? @map("monthly_max_installments")

  // Parcelamento SEM JUROS das VENDAS DE CURSOS aos alunos (Mercado Pago). O teto
  // de parcelas oferecido e sempre 12x (MAX_CARD_INSTALLMENTS); este campo define
  // ate quantas parcelas a unidade anuncia como "sem juros" (1 = so a vista sem
  // juros; acima disso, o aluno paga o juros do emissor). A verdade do valor vem
  // do MP (payer_costs) — depende do financiamento configurado na conta MP da
  // unidade; este campo e o "contrato comercial" exibido no checkout.
  interestFreeInstallments Int @default(1) @map("interest_free_installments")

  // Integracao Mercado Pago (vendas dos cursos)
  mpAccessToken   String? @map("mp_access_token") // Criptografado AES-256
  mpPublicKey     String? @map("mp_public_key")
  mpRefreshToken  String? @map("mp_refresh_token")
  mpConnected     Boolean @default(false) @map("mp_connected")
  mpUserId        String? @map("mp_user_id") // ID do revendedor no MP
  // Assinatura secreta do webhook MP DESTA conta (por revendedor). O MP gera
  // uma secret por aplicacao/conta — como cada unidade usa a propria conta,
  // cada uma tem a sua. Criptografada AES-256. A vitrine PMB usa MP_WEBHOOK_SECRET.
  mpWebhookSecret String? @map("mp_webhook_secret")

  // Integracao Asaas COMO GATEWAY DE VENDAS da unidade (vendas dos cursos aos
  // alunos via conta Asaas PROPRIA do revendedor). NAO confundir com os campos
  // asaas* acima (asaasCustomerId/asaasSubscriptionId) — aqueles sao a unidade
  // pagando a mensalidade dela PARA a PMB; estes sao a unidade RECEBENDO dos
  // alunos pela conta Asaas dela. Espelha o par mpAccessToken/mpWebhookSecret.
  //
  // asaasGatewayEnabled: DEPRECADO (migration 20260728_asaas_gateway_always_on).
  //   Era a capability liberada caso a caso pelo Admin Master; o Asaas deixou de
  //   ser feature opcional — toda unidade tem as duas opcoes de gateway. NADA no
  //   codigo le este campo; ele so continua aqui porque o DROP da coluna quebra a
  //   versao antiga durante a janela de deploy. Remover numa migration futura.
  // asaasApiKey: API key da conta Asaas da unidade (header access_token), AES-256.
  // asaasWebhookToken: token de auth do webhook que a unidade configura no painel
  //   Asaas dela e cola aqui — usado para validar os webhooks daquela conta. AES-256.
  // asaasConnected: a unidade ja informou a API key (espelha mpConnected).
  asaasGatewayEnabled Boolean @default(true) @map("asaas_gateway_enabled")
  asaasApiKey         String? @map("asaas_api_key") // Criptografado AES-256
  asaasWebhookToken   String? @map("asaas_webhook_token") // Criptografado AES-256
  asaasConnected      Boolean @default(false) @map("asaas_connected")

  // Carteira Asaas (walletId) DESTA unidade — o endereco para onde o split
  // manda dinheiro quando ela e a PRODUTORA de um curso vendido por outra loja.
  // Descoberto automaticamente por GET /v3/wallets/ com a propria asaasApiKey
  // (ver src/lib/course-authoring/wallet.ts): a unidade nunca digita este valor.
  //
  // Os dois gates sao de ALTURAS diferentes, de proposito:
  //   RECEBER (publicar curso alem da propria vitrine) — basta asaasWalletId.
  //   VENDER curso de terceiro — precisa de asaasConnected + asaasWebhookToken,
  //     porque a cobranca e EMITIDA na conta dela e ela reparte por split.
  asaasWalletId        String?   @map("asaas_wallet_id")
  asaasWalletCheckedAt DateTime? @map("asaas_wallet_checked_at")

  // Gateway ATIVO da vitrine da unidade. Uma venda por vez vai por um gateway.
  // MP (padrao) ou ASAAS (escolhivel assim que a unidade conecta a conta Asaas).
  // Lido em /api/loja/checkout para definir Enrollment.gateway.
  salesGateway PaymentGateway @default(MP) @map("sales_gateway")

  // Integracao com a plataforma de aulas
  plataformaVendedorId    String? @map("ea_vendedor_id") // ID do funcionario criado na plataforma
  plataformaVendedorLogin String? @map("ea_vendedor_login") // Login retornado pelo funcionarios/novo
  poloName                String? @map("polo_name") // Nome do polo usado no campo "polo" da plataforma

  // Dono do tenant (owner principal)
  owner User? @relation("TenantOwner")

  // Gerente de conta / suporte PMB (PMB_RESELLER_MGR atribuido)
  accountManagerId String? @map("account_manager_id")
  accountManager   User?   @relation("AccountManagerTenants", fields: [accountManagerId], references: [id])

  // Vendedor de revenda (PMB_REVENDA_SALES) que fechou/atende comercialmente esta
  // unidade. Setado na conversao do lead (ownerUserId -> salesUserId) ou manual.
  salesUserId String? @map("sales_user_id")
  salesUser   User?   @relation("SalesUserTenants", fields: [salesUserId], references: [id])

  // Membros do tenant (para multiplos admins/gerentes no futuro)
  members TenantMember[]

  // Indicacao (1-nivel)
  referralCode         String    @unique @map("referral_code")
  referrerTenantId     String?   @map("referrer_tenant_id")
  referrer             Tenant?   @relation("TenantReferrals", fields: [referrerTenantId], references: [id])
  referrals            Tenant[]  @relation("TenantReferrals")
  // Override individual do % de comissao (Decimal 0-100). Null = usa SystemSettings.defaultReferralPercent
  referralPercent      Decimal?  @map("referral_percent") @db.Decimal(5, 2)
  // Override individual do minimo de indicacoes ATIVAS para esta unidade
  // comecar a receber comissao de recorrencia. Null = usa
  // SystemSettings.defaultReferralMinReferrals (padrao 3). 0 = sem minimo.
  referralMinReferrals Int?      @map("referral_min_referrals")
  // Regras escalonadas de comissao DESTA unidade (quando ela e a INDICADA).
  // O percentual da comissao varia conforme os meses de calendario desde a
  // ativacao desta unidade (activatedAt). Formato JSON ordenado:
  //   [{ "untilMonth": 6, "percent": 50 }, { "untilMonth": null, "percent": 20 }]
  // -> meses 1..6 = 50%; do 7o em diante = 20% (untilMonth null = "em diante").
  // null/empty => sem escalonamento (cai no referralPercent / padrao global).
  referralTiers        Json?     @map("referral_tiers")
  // Data de ativacao da unidade (1a vez que entrou em ACTIVE / 1a mensalidade
  // paga). Base para contar os meses do escalonamento. Null => usa createdAt.
  activatedAt          DateTime? @map("activated_at")

  // Dados PIX para receber comissoes (PIX do indicador)
  pixKey     String? @map("pix_key")
  pixKeyType String? @map("pix_key_type") // CPF, CNPJ, EMAIL, PHONE, EVP

  // Override do motor de comissao por faixas para ESTE indicador. Null em cada
  // campo => herda o padrao global de SystemSettings.commission*. Ver
  // src/lib/referrals/rules.ts (resolucao override -> global).
  commissionMode           CommissionMode?         @map("commission_mode")
  commissionBracketBasis   CommissionBracketBasis? @map("commission_bracket_basis")
  commissionRateType       CommissionRateType?     @map("commission_rate_type")
  commissionPayoutBase     CommissionPayoutBase?   @map("commission_payout_base")
  // Faixas ordenadas (override): [{ "upTo": 10, "value": 100 }, { "upTo": null, "value": 200 }]
  commissionBrackets       Json?                   @map("commission_brackets")
  // Plano de comissao MULTI-FASE deste indicador (override). Quando preenchido,
  // tem prioridade sobre os campos commission* singulares acima (que viram
  // fallback). Cada fase vale por um intervalo de meses contados desde a entrada
  // do indicador no programa (commissionPlanStartedAt ?? createdAt). Formato:
  //   { "phases": [
  //       { "durationMonths": 3, "rateType": "FIXED", "bracketBasis": "ACTIVE_UNITS",
  //         "payoutBase": "ALL_ACTIVE", "brackets": [{ "upTo": 10, "value": 100 }, { "upTo": null, "value": 200 }] },
  //       { "durationMonths": null, "rateType": "PERCENT", ... }   // null = fase final "em diante"
  //   ] }
  // null/empty => sem plano multi-fase (cai nos campos singulares -> global).
  commissionPlan           Json?                   @map("commission_plan")
  // Ancora do relogio de fases DESTA unidade quando ela e a INDICADA: cada
  // unidade tem o seu proprio relogio (a fase ativa depende da idade DELA, nao
  // do indicador). Define o 1o mes do plano para esta unidade. Null => usa
  // activatedAt ?? createdAt.
  commissionPlanStartedAt  DateTime?               @map("commission_plan_started_at")
  // Origem do override de comissao: "MANUAL" (admin editou na tela do revendedor)
  // ou "FROZEN" (congelado automaticamente ao salvar a regra global com escopo
  // "apenas novas revendas"). Null => sem override (herda o global). FROZEN e
  // limpo quando o admin salva a global com escopo "todas"; MANUAL e preservado.
  commissionOverrideSource String?                 @map("commission_override_source")

  // Unidade Tecnica — link externo para escola tecnica do revendedor.
  // Quando habilitado pelo admin, exibe categoria/menu/secao "Cursos Tecnicos"
  // na vitrine; o clique abre uma tela de loading que redireciona para tecnicaUrl.
  tecnicaEnabled Boolean @default(false) @map("tecnica_enabled")
  tecnicaUrl     String? @map("tecnica_url")
  tecnicaLabel   String? @map("tecnica_label") // null = "Cursos Tecnicos"
  // Lista editavel de cursos exibidos na secao. Formato JSON:
  // [{ name: string, url: string, order: number }]. null/empty => sem cursos
  // (cai no fallback de mostrar so o CTA com tecnicaUrl).
  tecnicaCourses Json?   @map("tecnica_courses")

  // EJA — link externo para a pagina personalizada de EJA do revendedor.
  // Exibido como banner na home (HomeSection kind="eja"). A imagem do banner e
  // padronizada pela PMB (SystemSettings.ejaBannerImageUrl); aqui a unidade so
  // define o link de destino e o rotulo proprios. Sem ejaUrl, o banner e omitido.
  ejaEnabled Boolean @default(false) @map("eja_enabled")
  ejaUrl     String? @map("eja_url")
  ejaLabel   String? @map("eja_label") // null = "EJA"

  // Modulo Automacao — disparo de WhatsApp + CRM de leads. Quando habilitado
  // pelo admin, a vitrine exibe um card "Receba mais informacoes" na pagina
  // do curso e o painel ganha menus Automacao + Leads.
  automationEnabled      Boolean   @default(false) @map("automation_enabled")
  // Modulo "Revender revendas": quando habilitado pelo admin, esta unidade ganha
  // o menu de venda de revendas (/painel/revendas). As revendas que ela cria sao
  // cobradas no Asaas da PMB (sistema mae) e atreladas a ela via referrerTenantId
  // — ela vira uma especie de admin/suporte dessas sub-revendas.
  canSellResellers       Boolean   @default(false) @map("can_sell_resellers")
  // Modulo "Produzir cursos": a unidade cria curso proprio, define os termos
  // comerciais e publica alem da propria vitrine. Habilitacao COMERCIAL,
  // concedida pela equipe do sistema mae em /admin/revendedores/[id] →
  // "Vitrine & extras" — nao se confunde com a permissao `cursosAutorais.*`,
  // que diz QUEM dentro da unidade opera o modulo depois de ligado.
  courseAuthoringEnabled Boolean   @default(false) @map("course_authoring_enabled")
  // Nome unico da sessao no engine de WhatsApp (gerado como cuid na 1a conexao).
  waSessionName          String?   @unique @map("wa_session_name")
  // Telefone E.164 conectado (snapshot apos QR scan). Unique = um numero
  // so pode estar conectado a um tenant.
  waConnectedPhone       String?   @unique @map("wa_connected_phone")
  // Status local espelhado do engine: DISCONNECTED, CONNECTING, SCAN_QR_CODE,
  // WORKING, FAILED. Refrescado por polling.
  waStatus               String    @default("DISCONNECTED") @map("wa_status")
  waStatusUpdatedAt      DateTime? @map("wa_status_updated_at")
  // Horas apos checkout_started sem pagamento aprovado pra cair em ABANDONED.
  abandonedAfterHours    Int       @default(24) @map("abandoned_after_hours")
  // Distribuicao automatica de leads (rodizio/round-robin) entre os consultores
  // ativos da Equipe. Quando ligado, cada lead novo nasce com ownerUserId
  // apontando para o proximo consultor na fila. leadAssignCursor e o ponteiro
  // do rodizio (incrementado a cada atribuicao). Ver src/lib/automation/assign.ts.
  leadAutoAssign         Boolean   @default(false) @map("lead_auto_assign")
  leadAssignCursor       Int       @default(0) @map("lead_assign_cursor")

  // Pagamento parcelado/mensalidade (PaymentType.MONTHLY) por unidade.
  // monthlyAllowed: capability liberada pelo Admin Master.
  // monthlyEnabled: revendedor liga/desliga o uso (dentro do que foi liberado).
  // monthlyScope: onde o parcelado vale (definido pelo Admin Master).
  // Efetivo: monthlyAllowed && monthlyEnabled. Ver src/lib/tenant/monthly-policy.ts
  // Pagamento parcelado (mensalidade) — capability liberada pelo Admin Master +
  // toggle da revenda + escopo (venda direta / +vitrine). ALEM da mensalidade no
  // cartao, esta mesma capability habilita a venda parcelada no BOLETO (carne) na
  // venda direta — nao ha campo separado. Ver src/lib/installments/.
  monthlyAllowed Boolean      @default(false) @map("monthly_allowed")
  monthlyEnabled Boolean      @default(false) @map("monthly_enabled")
  monthlyScope   MonthlyScope @default(DIRECT_ONLY) @map("monthly_scope")

  // Cota de aulas (trava proporcional ao pagamento) por unidade.
  // null = herda SystemSettings.paceGateEnabled. Permite ligar a trava numa
  // unidade piloto antes da rede toda — ou desliga-la onde o parcelamento longo
  // tornaria a cota agressiva demais.
  paceGateEnabled Boolean? @map("pace_gate_enabled")

  // REGRAS PEDAGOGICAS padrao desta unidade: em que ordem as aulas abrem
  // (livre / sequencial / gotejamento), quantas por dia e em que dias e
  // horarios o aluno pode estudar. Formato e defaults em
  // src/lib/pedagogia/policy.ts (`PedagogyPolicy`); null = sem regra, que e
  // exatamente o comportamento historico.
  //
  // Json e nao colunas pelo mesmo motivo de `cancellationPolicy` e
  // `commissionPlan`: e um bloco que viaja INTEIRO para a plataforma de aulas
  // (PUT /api/v1/tenants/:id) e que ganha eixos novos sem migration.
  //
  // ⚠️ So e APLICADA em curso da plataforma propria (provider LMS). Na
  // fornecedora legada (EA) nao ha grade nossa para barrar aula a aula — o
  // unico eixo que alcanca a EA e a JANELA DE HORARIO, e ainda assim por
  // login, via `setStudentScheduleBlock`. Ver src/lib/pedagogia/ea-window.ts.
  pedagogyPolicy Json? @map("pedagogy_policy")

  // Relacoes
  tenantCourses                TenantCourse[]
  authoredCourses              Course[]                     @relation("AuthoredCourses")
  courseSaleSplits             CourseSaleSplit[]            @relation("CourseSplitBeneficiary")
  coursePackages               CoursePackage[]
  tenantPackages               TenantPackage[]
  subscriptionPlans            SubscriptionPlan[]
  tenantSubscriptionPlans      TenantSubscriptionPlan[]
  studentSubscriptions         StudentSubscription[]
  students                     Student[]
  enrollments                  Enrollment[]
  payments                     Payment[]
  coupons                      Coupon[]
  tenantPayments               TenantPayment[]
  webhookLogs                  WebhookLog[]
  leads                        Lead[]                       @relation("LeadConvertedTenant")
  referredLeads                Lead[]                       @relation("LeadReferrer")
  supportNotes                 TenantSupportNote[]
  referralCommissionsReceived  ReferralCommission[]         @relation("ReferrerCommissions")
  referralCommissionsGenerated ReferralCommission[]         @relation("ReferredCommissions")
  referralMonthlyCommissions   ReferralMonthlyCommission[]  @relation("ReferrerMonthlyCommissions")
  referralPayouts              ReferralPayout[]
  certificates                 Certificate[]
  certificateTemplate          CertificateTemplate?
  notificationOverrides        TenantNotificationOverride[]
  bannerSlides                 BannerSlide[]
  homeSections                 HomeSection[]
  studentLeads                 StudentLead[]
  automationTemplates          AutomationMessageTemplate[]
  contactMessages              ContactMessage[]
  visitorEvents                VisitorEvent[]
  slugRedirects                TenantSlugRedirect[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([slug])
  @@index([customDomain])
  @@index([status])
  @@index([accountManagerId])
  @@index([salesUserId])
  @@index([referrerTenantId])
  @@index([referralCode])
  @@map("tenants")
}

// Subdominios antigos de uma revenda apos um rename de slug. Enquanto a reserva
// esta valida (expiresAt no futuro): (1) o subdominio antigo redireciona para o
// slug atual da unidade no proxy/edge e (2) o slug fica indisponivel para outras
// revendas (checado em isSlugAvailable). Passado expiresAt, a linha e ignorada
// (e pode ser limpa por cron de higiene) e o slug volta a ficar livre.
// Guardamos tenantId (nao o slug novo): o alvo do redirect e sempre o slug atual
// da unidade, o que trata renames encadeados (A->B->C: A redireciona para C).
model TenantSlugRedirect {
  id        String   @id @default(cuid())
  oldSlug   String   @unique @map("old_slug")
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([expiresAt])
  @@map("tenant_slug_redirects")
}

model TenantSupportNote {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  authorId  String   @map("author_id")
  body      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User   @relation("SupportNotes", fields: [authorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([authorId], map: "tenant_support_notes_author_id_idx")
  @@map("tenant_support_notes")
}

// ============================================================
// NOTAS INTERNAS POR ALUNO (visiveis a admin/equipe/revendedor)
// ============================================================
// Comentarios da gestao sobre um aluno especifico — historico de
// suporte, observacoes, contexto que admin/revendedor anota.
// Nao e visivel para o aluno; vive em /admin/alunos/[id] e
// /painel/alunos/[id], aba "Notas".

model StudentNote {
  id        String   @id @default(cuid())
  studentId String   @map("student_id")
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String   @map("author_id")
  author    User     @relation("StudentNotes", fields: [authorId], references: [id])
  body      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([studentId, createdAt])
  @@index([authorId], map: "student_notes_author_id_idx")
  @@map("student_notes")
}

// ============================================================
// CURSOS (sincronizados da plataforma de aulas)
// ============================================================

// Alcance escolhido pelo AUTOR de um curso de autoria da unidade. Eixo
// independente de `Course.visibilityMode`, que continua sendo a curadoria da PMB
// (ela ainda pode bloquear um curso numa unidade especifica). Os dois filtram.
//   OWN_ONLY    — so a vitrine de quem criou
//   OWN_AND_PMB — a vitrine do autor + a vitrine principal da PMB
//   NETWORK     — todas as vitrines (autor + PMB + demais unidades com carteira)
enum CourseDistribution {
  OWN_ONLY
  OWN_AND_PMB
  NETWORK
}

// O que o numero digitado pelo autor (`Course.authorAmount`) SIGNIFICA.
//   FIXED            — preco final, igual em toda vitrine
//   MIN_PRICE        — piso de preco; a unidade vende por igual ou mais
//   MIN_PRODUCER_NET — quanto o PRODUTOR recebe por venda; a diferenca e do
//                      vendedor. O preco minimo de venda passa a ser
//                      authorAmount / (1 - comissao - taxa), calculado em
//                      src/lib/course-authoring/split.ts.
enum AuthoredPricingMode {
  FIXED
  MIN_PRICE
  MIN_PRODUCER_NET
}

// Ciclo de vida do curso de autoria. Nao ha aprovacao da PMB: DRAFT -> PUBLISHED
// e ato do proprio autor. PAUSED e a intervencao REATIVA do /admin (tira das
// vitrines sem apagar historico nem matricula).
enum AuthoredCourseStatus {
  DRAFT
  PUBLISHED
  PAUSED
}

// Fornecedora de origem do curso. EA = fornecedora legada (integracao
// form-data PHP em src/lib/plataforma-cursos). LMS = fornecedora propria
// (API REST JSON em src/lib/lms). A fornecedora define o canal
// de provisionamento, acesso e sincronizacao de progresso — a vitrine/checkout
// sao agnosticos de provider. Cursos existentes nascem EA (default).
enum CourseProvider {
  EA
  LMS
}

// TIPO DE CONTEUDO vendido. Discriminador, no molde de `CourseProvider`: toda a
// camada comercial (matricula, cobranca, cupom, split, pacote, assinatura) e
// COMPARTILHADA — o que muda e o que o aluno recebe e, por isso, o que a pagina
// de venda promete.
//
//   COURSE — aulas em video na plataforma de aulas. Tudo o que existia ate aqui.
//   EBOOK  — um arquivo para ler. Sem aula, sem prova, sem carga horaria de
//            curso livre e SEM CERTIFICADO (ver src/lib/catalog/content-type.ts).
//
// So a fornecedora propria (LMS) produz e-book: a legada (EA) e uma plataforma
// de aulas em video e nao tem o conceito. O sync EA nunca grava este campo, e o
// default cobre todo o catalogo existente.
enum ContentType {
  COURSE
  EBOOK
}

model Course {
  id String @id @default(cuid())

  // Fornecedora de origem (ver enum CourseProvider)
  provider CourseProvider @default(EA)

  // Tipo de conteudo (ver enum ContentType). Espelha `Course.contentType` do
  // LMS, que e o dono: o sync o traz junto do resto do catalogo. Nao e editavel
  // aqui — trocar o tipo de um produto ja vendido reescreveria o que o aluno
  // comprou.
  contentType ContentType @default(COURSE) @map("content_type")

  // ── Metadados de e-book (contentType = EBOOK) ──
  // So o que a PAGINA DE VENDA precisa dizer. O ARQUIVO nunca chega aqui: ele
  // e o produto, mora no LMS e so e servido a quem tem matricula.
  ebookPages        Int?    @map("ebook_pages")
  // O aluno pode baixar o arquivo, ou so le na plataforma? Decisao do autor,
  // sincronizada do LMS — a vitrine anuncia o que ele vai poder fazer.
  ebookDownloadable Boolean @default(true) @map("ebook_downloadable")

  // Dados da plataforma de aulas
  // ATENCAO: a API cursos/listar NAO retorna ID do curso!
  // plataformaCourseId pode ser: (1) descoberto via testes, (2) inferido da ordem, ou (3) null
  // O campo "nome" e usado como chave alternativa de match no sync (escopo EA)
  plataformaCourseId String? @unique @map("ea_course_id") // ID na plataforma EA (pode ser null se API nao retornar)
  // Identidade no LMS (so preenchidos quando provider=LMS). lmsCourseId (UUID) e
  // a chave de match ESTAVEL do sync LMS (substitui o match-por-nome fragil da EA).
  lmsCourseId        String? @unique @map("lms_course_id")
  lmsSlug            String? @map("lms_slug")
  nome               String // Match no sync via @@unique([provider, nome]) — ver abaixo
  descricao          String? @db.Text // Campo "obs" da API
  qtdAulas           Int     @map("qtd_aulas") // Campo "aulas"
  cargaHoraria       String? @map("carga_horaria")

  // Matriz curricular (conteudo programatico). Lista de topicos exibida na
  // pagina do curso e no verso do certificado. Conteudo global PMB (igual para
  // TODAS as vitrines — mae, revendas ativas/pendentes e futuras), curado a
  // partir dos PDFs oficiais de matriz. Vazio => curso sem matriz: a pagina e o
  // verso do certificado seguem o layout atual (sem a secao).
  matrizCurricular String[] @default([]) @map("matriz_curricular")

  // Bullets da secao "O que voce vai aprender" na pagina do curso. Conteudo
  // global PMB editado no catalogo do admin: e o PADRAO herdado por TODAS as
  // vitrines (mae, revendas ativas e futuras). Cada revenda pode sobrescrever
  // so na sua vitrine via TenantCourse.customAprendizado. Vazio => a pagina cai
  // no texto generico APRENDIZADO_DEFAULT (src/lib/courses/aprendizado.ts).
  aprendizado       String[] @default([])
  precoOriginal     Decimal? @map("preco_original") @db.Decimal(10, 2) // Parseado do formato BR
  precoPromocional  Decimal? @map("preco_promocional") @db.Decimal(10, 2)
  parcelasSugeridas Int?     @map("parcelas_sugeridas") // Campo "parcelas"

  // Categorias
  // categoriaLoja/categoriaInterna sao o "raw" vindo da plataforma parceira
  // pelo sync — preservados para audit/match.
  //
  // Um curso pode pertencer a VARIAS categorias (M2M via CourseCategory em
  // `categoryLinks`). `categoryId` aponta para a categoria PRINCIPAL (a primeira
  // selecionada / a vinda do sync) e e mantido apenas para exibicao quando uma
  // unica categoria e necessaria e para compatibilidade. A fonte de verdade do
  // pertencimento (filtros, menus, contagens) e SEMPRE o join `categoryLinks`,
  // que tambem inclui a categoria principal.
  categoriaInterna String?          @map("categoria_interna")
  categoriaLoja    String?          @map("categoria_loja")
  categoryId       String?          @map("category_id")
  category         Category?        @relation(fields: [categoryId], references: [id])
  categoryLinks    CourseCategory[]

  // Visibilidade nas vitrines de revendas (independente de hiddenMain, que
  // controla so a vitrine principal PMB).
  //   ALL        — disponivel para todos os revendedores ativos (default)
  //   ALLOWLIST  — apenas os tenants em `allowedTenantIds` veem
  //   DENYLIST   — todos veem EXCETO os tenants em `blockedTenantIds`
  // Cada tenant ainda pode ocultar individualmente via TenantCourse.isVisible.
  visibilityMode   CourseVisibility @default(ALL) @map("visibility_mode")
  allowedTenantIds String[]         @default([]) @map("allowed_tenant_ids")
  blockedTenantIds String[]         @default([]) @map("blocked_tenant_ids")

  // ── Autoria da unidade (marketplace de duas pontas) ──
  // authorTenantId null = catalogo da PMB (TODO o legado e todo curso vindo do
  // sync EA/LMS). Preenchido = curso PRODUZIDO por uma unidade, que escolhe
  // alcance, preco e a comissao de quem vender.
  //
  // Estes campos moram no Course pelo mesmo motivo que `precoVitrineMain` e
  // `visibilityMode`: os syncs preservam curadoria de proposito (sync.ts e
  // sync-lms.ts so reescrevem o que a fornecedora e dona). Um sync NUNCA pode
  // sobrescrever termo comercial de autoria.
  authorTenantId          String?               @map("author_tenant_id")
  authorTenant            Tenant?               @relation("AuthoredCourses", fields: [authorTenantId], references: [id], onDelete: Restrict)
  authorUserId            String?               @map("author_user_id")
  authoredStatus          AuthoredCourseStatus? @map("authored_status")
  distribution            CourseDistribution    @default(OWN_ONLY)
  pricingMode             AuthoredPricingMode   @default(FIXED) @map("pricing_mode")
  authorAmount            Decimal?              @map("author_amount") @db.Decimal(10, 2)
  sellerCommissionPercent Decimal?              @map("seller_commission_percent") @db.Decimal(5, 2)
  // Snapshot da taxa da plataforma no momento da publicacao — NAO leitura viva.
  // Mesma disciplina de ReferralMonthlyCommission: mudar a taxa global amanha
  // nao pode reescrever o que ja foi acordado com o produtor.
  platformFeePercent      Decimal?              @map("platform_fee_percent") @db.Decimal(5, 2)

  // Exibicao
  destaque     Boolean @default(false)
  status       String  @default("ATIVO") // ATIVO / INATIVO
  precoMostrar Boolean @default(false) @map("preco_mostrar")
  capaImageUrl String? @map("capa_image_url")

  // Overrides da vitrine principal PMB (curadoria admin — nao tocar no sync)
  precoVitrineMain   Decimal?    @map("preco_vitrine_main") @db.Decimal(10, 2)
  // Preco DE TABELA da vitrine PMB — o "De R$ X" riscado ao lado do preco de
  // venda. Curadoria do admin, editavel em /admin/catalogo.
  //
  // NAO confundir com `precoOriginal`: aquele e o preco-base que vem do FEED
  // (EA e LMS) e e reescrito a cada sync diario, entao nunca foi editavel aqui.
  // Este e override puro — o sync nunca o toca, pela mesma regra de
  // `precoVitrineMain`.
  //
  // null (ou <= preco de venda) => a vitrine nao exibe "De". Nao ha fallback
  // para `precoOriginal`: quem decide o ancora e quem edita o catalogo.
  precoDeVitrineMain Decimal?    @map("preco_de_vitrine_main") @db.Decimal(10, 2)
  destaqueHome       Boolean     @default(false) @map("destaque_home")
  ordemHome          Int?        @map("ordem_home")
  hiddenMain         Boolean     @default(false) @map("hidden_main")
  descricaoOverride  String?     @map("descricao_override") @db.Text
  capaOverride       String?     @map("capa_override")
  parcelasOverride   Int?        @map("parcelas_override")
  paymentTypeMain    PaymentType @default(ONE_TIME) @map("payment_type_main") // ONE_TIME ou MONTHLY na vitrine PMB
  monthlyMonthsMain  Int?        @map("monthly_months_main") // Quantidade de mensalidades quando paymentTypeMain=MONTHLY

  // Slug para URL amigavel (gerado do nome)
  slug String @unique

  // Controle de sync
  syncedAt DateTime @default(now()) @map("synced_at")

  // Relacoes
  tenantCourses TenantCourse[]
  enrollments   Enrollment[]
  courseLessons CourseLesson[]
  certificates  Certificate[]
  studentLeads  StudentLead[]
  visitorEvents VisitorEvent[]
  packageItems  CoursePackageItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Nome e unico POR FORNECEDORA **E POR AUTOR**: um curso EA e um curso LMS
  // podem ter o mesmo titulo sem colidir, e duas unidades podem publicar
  // "Excel Basico" sem uma barrar a outra.
  //
  // ATENCAO: Postgres trata NULL como distinto, entao este composto NAO dedupe
  // o catalogo da PMB (author_tenant_id IS NULL). A garantia antiga e preservada
  // por um INDICE UNICO PARCIAL criado na migration
  // (20260821_course_authoring: courses_provider_nome_pmb_key). Como o Prisma
  // nao faz findUnique em composto com coluna nula, o sync EA casa por
  // findFirst({ provider, nome, authorTenantId: null }) — ver src/lib/catalog/sync.ts.
  @@unique([provider, authorTenantId, nome])
  @@index([authorTenantId, authoredStatus])
  @@index([provider])
  @@index([contentType])
  @@index([status])
  @@index([categoriaLoja])
  @@index([categoryId])
  @@map("courses")
}

/// Categorias curadas pelo admin. Sincronizadas a partir de
/// Course.categoriaLoja (sync da plataforma parceira) mas tambem podem ser
/// criadas/editadas manualmente. Cursos sem categoryId aparecem em
/// "sem categoria" e nao listam no menu publico de categorias.
model Category {
  id           String  @id @default(cuid())
  name         String  @unique
  slug         String  @unique
  displayOrder Int     @default(0) @map("display_order")
  isActive     Boolean @default(true) @map("is_active")
  description  String? @db.Text

  // `courses` = cursos cuja categoria PRINCIPAL e esta (relacao via categoryId).
  // `courseLinks` = TODOS os cursos vinculados (M2M), fonte de verdade para
  // contagens e filtros de pertencimento.
  courses     Course[]
  courseLinks CourseCategory[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("categories")
}

/// Vinculo muitos-para-muitos entre Course e Category. Um curso pode aparecer
/// em quantas categorias forem necessarias. Inclui a categoria principal
/// (Course.categoryId), de modo que filtrar pelo join sempre encontra o curso.
model CourseCategory {
  courseId   String   @map("course_id")
  categoryId String   @map("category_id")
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([courseId, categoryId])
  @@index([categoryId])
  @@map("course_categories")
}

model CourseLesson {
  id       String @id @default(cuid())
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  nome     String // Campo "aula" da API
  ordem    Int // Ordem sequencial

  @@unique([courseId, ordem])
  @@map("course_lessons")
}

// ============================================================
// CONFIGURACAO DE CURSO POR REVENDEDOR
// ============================================================

model TenantCourse {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId String @map("course_id")
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // Precificacao do revendedor
  price       Decimal     @db.Decimal(10, 2) // Preco definido pelo revendedor
  // Preco DE TABELA desta vitrine — o "De R$ X" riscado. Definido pela
  // unidade, independente do "De" da PMB: quem vende e quem escolhe a ancora.
  // null (ou <= `price`) => a vitrine nao exibe "De".
  precoDe     Decimal?    @map("preco_de") @db.Decimal(10, 2)
  paymentType PaymentType @default(ONE_TIME) @map("payment_type")

  // Se mensal, dados do plano no MP
  mpPlanId String? @map("mp_plan_id") // preapproval_plan_xxxx

  // Visibilidade e customizacao
  isVisible         Boolean  @default(true) @map("is_visible")
  customDescription String?  @map("custom_description") @db.Text
  customCapaUrl     String?  @map("custom_capa_url")
  // Override da secao "O que voce vai aprender" SO nesta vitrine. Vazio =>
  // herda Course.aprendizado (padrao definido pela PMB no catalogo mae).
  customAprendizado String[] @default([]) @map("custom_aprendizado")
  customParcelas    Int?     @map("custom_parcelas")
  customOrder       Int      @default(0) @map("custom_order") // Ordem na vitrine
  isFeatured        Boolean  @default(false) @map("is_featured") // Destaque na vitrine

  // Override das REGRAS PEDAGOGICAS so nesta vitrine. null => herda
  // `Tenant.pedagogyPolicy`. O override e do TenantCourse (a linha "curso X
  // nesta vitrine") e nao do Course de proposito: o mesmo curso e vendido por
  // varias unidades, cada uma com o proprio ritmo. Vale INTEIRO — ver
  // `resolvePolicy` em src/lib/pedagogia/policy.ts.
  pedagogyPolicy Json? @map("pedagogy_policy")

  enrollments Enrollment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, courseId])
  @@index([tenantId, isVisible])
  @@map("tenant_courses")
}

// ============================================================
// PACOTES DE CURSOS
// ============================================================
// Um pacote agrupa varios cursos vendidos por um preco unico. Comprar o pacote
// libera TODOS os cursos para o aluno (ver fulfill: matricula primaria + satelites).
//
// Pacotes da PMB (tenantId=null) sao distribuidos AUTOMATICAMENTE a todas as
// vitrines de revenda (atuais e futuras) — segue o padrao de fallback de
// Course/HomeSection/Coupon. A revenda nao edita os cursos do pacote PMB, mas
// pode (via TenantPackage) definir o proprio preco, ocultar/excluir da propria
// vitrine e destacar. Pacotes proprios da revenda tem tenantId setado.

model CoursePackage {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id") // null = pacote da PMB (auto-distribuido)
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  slug          String
  description   String? @db.Text
  coverImageUrl String? @map("cover_image_url")
  // Preco sugerido (pacote PMB) / preco proprio (pacote da revenda). A revenda
  // pode sobrescrever o preco de um pacote PMB via TenantPackage.price.
  price         Decimal @db.Decimal(10, 2)
  featured      Boolean @default(false)
  position      Int     @default(0)
  enabled       Boolean @default(true)

  // Auditoria (sem FK — apenas registro do criador)
  createdByUserId String?   @map("created_by_user_id")
  createdByRole   UserRole? @map("created_by_role")

  items             CoursePackageItem[]
  tenantPackages    TenantPackage[]
  enrollments       Enrollment[]
  subscriptionPlans SubscriptionPlan[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, enabled])
  @@map("course_packages")
}

model CoursePackageItem {
  id        String        @id @default(cuid())
  packageId String        @map("package_id")
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  courseId  String        @map("course_id")
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Int           @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([packageId, courseId])
  @@index([courseId])
  @@map("course_package_items")
}

// Override por revenda de um pacote (PMB ou proprio). Ausencia da linha => usa
// os defaults do CoursePackage (preco sugerido, visivel). isVisible=false =>
// "excluido da minha vitrine" (a revenda removeu o pacote PMB da propria loja).
model TenantPackage {
  id        String        @id @default(cuid())
  tenantId  String        @map("tenant_id")
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  packageId String        @map("package_id")
  package   CoursePackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  price          Decimal? @db.Decimal(10, 2) // null = usa CoursePackage.price
  isVisible      Boolean  @default(true)
  isFeatured     Boolean  @default(false) @map("is_featured")
  customOrder    Int      @default(0) @map("custom_order")
  customCoverUrl String?  @map("custom_cover_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, packageId])
  @@index([tenantId, isVisible])
  @@map("tenant_packages")
}

// ============================================================
// ASSINATURAS DE ALUNO
// ============================================================
// Acesso recorrente a um CONJUNTO de cursos enquanto o aluno paga a
// mensalidade. Diferente de PaymentType.MONTHLY, que e um parcelado mensal com
// FIM programado (maxPayments no Asaas / end_date no MP): a assinatura renova
// ate ser cancelada.
//
// Distribuicao segue o padrao de CoursePackage: plano com tenantId=null e da
// PMB e aparece automaticamente em TODAS as vitrines (atuais e futuras); a
// revenda so ajusta preco/visibilidade via TenantSubscriptionPlan.

model SubscriptionPlan {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id") // null = plano da PMB (auto-distribuido)
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name          String
  slug          String
  description   String? @db.Text
  coverImageUrl String? @map("cover_image_url")
  /// Valor de CADA ciclo (plano PMB = sugerido; da revenda = o dela). No
  /// vitalicio e o valor unico cobrado.
  price         Decimal @db.Decimal(10, 2)

  /// De quanto em quanto tempo se cobra. Fica no PLANO e nao no
  /// `TenantSubscriptionPlan`: a unidade ajusta PRECO e visibilidade, nunca a
  /// natureza do produto — um plano anual virando mensal numa loja so mudaria o
  /// que a rede inteira entende por aquele nome.
  interval SubscriptionInterval @default(MONTHLY)

  /// Como o conjunto de cursos e determinado. Ver SubscriptionScope.
  scope       SubscriptionScope @default(ALL)
  /// scope=CATEGORY: aceita varias categorias (o aluno alcanca a uniao delas).
  categoryIds String[]          @default([]) @map("category_ids")
  /// scope=PACKAGE: os cursos vem dos itens deste pacote.
  packageId   String?           @map("package_id")
  package     CoursePackage?    @relation(fields: [packageId], references: [id], onDelete: SetNull)
  /// scope=COURSES: lista fixa.
  courseIds   String[]          @default([]) @map("course_ids")

  featured Boolean @default(false)
  position Int     @default(0)
  enabled  Boolean @default(true)

  // Auditoria (sem FK — apenas registro do criador)
  createdByUserId String?   @map("created_by_user_id")
  createdByRole   UserRole? @map("created_by_role")

  tenantPlans   TenantSubscriptionPlan[]
  subscriptions StudentSubscription[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, slug])
  @@index([tenantId, enabled])
  @@map("subscription_plans")
}

/// Override por revenda de um plano (PMB ou proprio). Ausencia da linha => usa
/// os defaults do plano. isVisible=false => "removi da minha vitrine".
model TenantSubscriptionPlan {
  id       String           @id @default(cuid())
  tenantId String           @map("tenant_id")
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  planId   String           @map("plan_id")
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  price          Decimal? @db.Decimal(10, 2) // null = usa SubscriptionPlan.price
  isVisible      Boolean  @default(true) @map("is_visible")
  isFeatured     Boolean  @default(false) @map("is_featured")
  customOrder    Int      @default(0) @map("custom_order")
  customCoverUrl String?  @map("custom_cover_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, planId])
  @@index([tenantId, isVisible])
  @@map("tenant_subscription_plans")
}

/// A assinatura de UM aluno. E ela que da acesso: `currentPeriodEnd` diz ate
/// quando o ciclo pago vale.
model StudentSubscription {
  id        String           @id @default(cuid())
  studentId String           @map("student_id")
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenantId  String?          @map("tenant_id") // null = vitrine principal PMB
  tenant    Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  planId    String           @map("plan_id")
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])

  status SubscriptionStatus @default(PENDING)

  /// Preco CONGELADO na contratacao. O preco do plano muda; o que o assinante
  /// paga, nao — sem isto um reajuste no catalogo reprecificaria retroativamente
  /// todo mundo.
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)

  /// Periodicidade CONGELADA na contratacao, pelo mesmo motivo do preco: e ela
  /// que a renovacao usa para empurrar `currentPeriodEnd`. Ler do plano faria
  /// um assinante mensal virar anual (ou perder o vitalicio) no dia em que
  /// alguem editasse o catalogo.
  interval SubscriptionInterval @default(MONTHLY)

  /// Quem VENDEU, quando a assinatura nasceu de uma venda direta (/admin/vendas
  /// ou /painel/vendas). null = contratacao pelo proprio aluno na vitrine. E o
  /// campo pelo qual o recorte de carteira (`ctx.scope.vendas`) enxerga a venda
  /// — sem ele a assinatura vendida sumiria da lista de quem a vendeu.
  soldByUserId String? @map("sold_by_user_id")

  /// Link que o aluno abre para pagar/autorizar a 1a cobranca (fatura do Asaas
  /// ou `init_point` do MP). Guardado pelo mesmo motivo de
  /// `Enrollment.asaasInvoiceUrl`: ele so e devolvido UMA vez, na resposta da
  /// venda direta — sem a coluna, o vendedor que fechasse a aba perdia o link e
  /// nao tinha como recupera-lo em lugar nenhum.
  checkoutUrl String? @map("checkout_url")

  gateway     PaymentGateway @default(MP)
  /// CREDIT_CARD (debito automatico), PIX ou BOLETO (fatura mensal manual).
  billingType String?        @map("billing_type")

  // Ids da recorrencia no gateway
  mpPreapprovalId     String? @unique @map("mp_preapproval_id") // preapproval_xxxx
  asaasSubscriptionId String? @unique @map("asaas_subscription_id")
  asaasCustomerId     String? @map("asaas_customer_id")
  externalReference   String? @map("external_reference")

  /// Fim do ciclo PAGO. E o predicado de acesso — nao `status` sozinho, que fica
  /// PAST_DUE durante a carencia e ainda deve liberar.
  currentPeriodEnd DateTime? @map("current_period_end")

  startedAt         DateTime? @map("started_at")
  cancelledAt       DateTime? @map("cancelled_at")
  /// Pedido de cancelamento que so vale no fim do ciclo ja pago.
  cancelAtPeriodEnd Boolean   @default(false) @map("cancel_at_period_end")

  couponId String? @map("coupon_id")
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  payments    SubscriptionPayment[]
  enrollments Enrollment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId, status])
  @@index([tenantId, status])
  // Varredura de renovacao/carencia do cron.
  @@index([status, currentPeriodEnd])
  // Listagem de vendas diretas, com e sem recorte de carteira.
  @@index([tenantId, soldByUserId])
  @@map("student_subscriptions")
}

/// Uma cobranca de ciclo da assinatura.
///
/// Model proprio em vez de reusar `Payment`: la `enrollmentId` e NOT NULL e
/// alimenta o BI (@@index([mpStatus, paidAt])). Torna-lo opcional espalharia
/// null por relatorios que hoje assumem matricula.
model SubscriptionPayment {
  id             String              @id @default(cuid())
  subscriptionId String              @map("subscription_id")
  subscription   StudentSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenantId       String?             @map("tenant_id") // espelha a assinatura

  amount  Decimal        @db.Decimal(10, 2)
  gateway PaymentGateway

  mpPaymentId    String? @unique @map("mp_payment_id")
  asaasPaymentId String? @unique @map("asaas_payment_id")

  status      String // PENDING, CONFIRMED, RECEIVED, OVERDUE, REFUNDED...
  billingType String?   @map("billing_type")
  dueDate     DateTime  @map("due_date")
  paidAt      DateTime? @map("paid_at")

  invoiceUrl  String? @map("invoice_url") @db.Text
  bankSlipUrl String? @map("bank_slip_url") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([subscriptionId])
  @@index([tenantId, paidAt])
  @@index([status, dueDate])
  @@map("subscription_payments")
}

// ============================================================
// ALUNOS
// ============================================================

model Student {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Dados pessoais
  nome       String
  email      String?
  fone       String?
  fone2      String?
  cpf        String?
  rg         String?
  sexo       String?
  nascimento DateTime?

  // ── Responsavel financeiro (aluno menor de idade) ────────────────────────
  // Quem PAGA e responde legalmente, quando nao e o proprio aluno. O aluno
  // continua sendo o titular do certificado: `nome`/`cpf` acima sao sempre os
  // DELE. Ver src/lib/students/guardian.ts (regra) e src/lib/checkout/payer.ts
  // (roteamento da cobranca).
  //
  // Os tres primeiros ja existiam desde a migration inicial (herdados do schema
  // da plataforma de aulas, que sempre aceitou responsavel/rg/cpf) e nunca
  // foram escritos por codigo nosso.
  responsavel                String? // Nome do responsavel (menores)
  rgResponsavel              String?   @map("rg_responsavel")
  cpfResponsavel             String?   @map("cpf_responsavel")
  responsavelEmail           String?   @map("responsavel_email")
  responsavelFone            String?   @map("responsavel_fone")
  responsavelParentesco      String?   @map("responsavel_parentesco")
  /// Quando o bloco foi COLETADO. Nao e um booleano derivado de `nascimento`:
  /// booleano derivado desincroniza, que e exatamente a doenca que este
  /// recurso combate. null = nunca passou pelo fluxo novo (legado da EA).
  responsavelDefinidoEm      DateTime? @map("responsavel_definido_em")
  /// Customer Asaas DO RESPONSAVEL. Separado de `asaasCustomerId` de proposito:
  /// gravar o `cus_` da mae naquele campo faria o aluno cobrar nela PARA SEMPRE,
  /// inclusive depois dos 18, e o reuso do customer nunca detectaria o erro.
  responsavelAsaasCustomerId String?   @map("responsavel_asaas_customer_id")

  /// Marca "olhei a titularidade deste cadastro e esta correta". Substitui um
  /// model de fila inteiro — a base cabe numa tela. Ver src/lib/students/titularity/.
  titularidadeRevisadaEm    DateTime? @map("titularidade_revisada_em")
  titularidadeRevisadaPorId String?   @map("titularidade_revisada_por_id")

  // Endereco
  rua    String?
  bairro String?
  cidade String?
  estado String?
  numero String?
  cep    String?

  obs String? @db.Text

  // Asaas
  asaasCustomerId String? @map("asaas_customer_id")

  // plataforma de aulas
  plataformaAlunoId    String  @map("ea_aluno_id") // Login retornado por usuarios/novo
  plataformaAlunoSenha String? @map("ea_aluno_senha") // Criptografada
  polo                 String // = tenant.slug (enviado a plataforma)
  vendedorId           String? @map("vendedor_id") // = tenant.plataformaVendedorId

  // Id do aluno no LMS (so auditoria — operamos por Student.id como externalId).
  // Preenchido quando POST /api/v1/enrollments retorna studentId.
  lmsStudentId String? @map("lms_student_id")

  // Status na plataforma
  status   StudentStatus  @default(ATIVO)
  apostila ApostilaStatus @default(LIBERADA)

  // Marca de que o aluno esta bloqueado na plataforma de aulas por estar FORA
  // DA JANELA DE HORARIO da unidade — e nao por inadimplencia, cota ou decisao
  // de alguem. E o DISCRIMINADOR da trava: `Student.status` e um enum unico e
  // BLOQUEADO ja pertence a inadimplencia; sem esta coluna, a liberacao das
  // 08:00 nao teria como saber se aquele BLOQUEADO era dela ou de outra regra
  // — e devolveria acesso a um inadimplente.
  //
  // Escrita SO por `setStudentScheduleBlock` (src/lib/pedagogia/ea-window.ts),
  // que so bloqueia quem esta ATIVO e so libera quem tem esta marca. O indice
  // e PARCIAL (`WHERE schedule_blocked_at IS NOT NULL`) e por isso vive so na
  // migration — o Prisma nao expressa indice parcial no schema.
  scheduleBlockedAt DateTime? @map("schedule_blocked_at")

  // Controle
  certificado Boolean   @default(false)
  bolsista    Boolean   @default(false)
  dataFinal   DateTime? @map("data_final") // Data final do acesso

  // Acesso ao painel /aluno
  passwordHash      String?   @map("password_hash") // null = ainda nao definiu senha
  passwordSetAt     DateTime? @map("password_set_at")
  resetToken        String?   @unique @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")
  lastLoginAt       DateTime? @map("last_login_at")

  // Tours guiados (driver.js) da área do aluno já vistos/dispensados. Mesmo
  // mecanismo do User.dismissedTours, mas para a sessão de aluno. Ver src/lib/tours/.
  dismissedTours String[] @default([]) @map("dismissed_tours")

  // Relacoes
  enrollments     Enrollment[]
  subscriptions   StudentSubscription[]
  certificates    Certificate[]
  notes           StudentNote[]
  contactMessages ContactMessage[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, email])
  @@unique([tenantId, cpf])
  @@index([tenantId])
  // Login do aluno aceita o CPF do RESPONSAVEL (src/lib/auth.ts): depois de uma
  // correcao de titularidade o `cpf` passa a ser o do filho, e sem este OR a mae
  // — que era quem vinha entrando — perderia o acesso em silencio.
  @@index([tenantId, cpfResponsavel])
  @@index([plataformaAlunoId])
  @@index([tenantId, status])
  @@index([resetToken])
  // DB-001: BI hub conta alunos novos por bucket de created_at (platform-wide,
  // sem tenant líder) e agrupa por estado — sem estes, seq scan da maior tabela.
  @@index([createdAt])
  @@index([estado])
  @@map("students")
}

// ============================================================
// MATRICULAS
// ============================================================

model Enrollment {
  id             String        @id @default(cuid())
  tenantId       String?       @map("tenant_id") // null = vitrine principal PMB
  // onDelete: Restrict explicito reflete o estado REAL do banco (init migration).
  // Sem ele, o Prisma assumiria SetNull (default p/ relacao opcional) e um futuro
  // `prisma migrate` geraria uma migration destrutiva trocando RESTRICT->SET NULL.
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  studentId      String        @map("student_id")
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenantCourseId String?       @map("tenant_course_id") // null para vendas vitrine PMB
  tenantCourse   TenantCourse? @relation(fields: [tenantCourseId], references: [id], onDelete: Restrict)

  // Vendedor (PMB_SALES ou consultor que originou)
  soldByUserId String? @map("sold_by_user_id")
  soldByUser   User?   @relation("SoldEnrollments", fields: [soldByUserId], references: [id])
  courseId     String  @map("course_id")
  course       Course  @relation(fields: [courseId], references: [id])

  // Pacotes de cursos. Quando a compra e de um PACOTE, criamos UMA matricula
  // PRIMARIA (packagePrimary=true) que carrega o Payment do valor cheio do
  // pacote + N matriculas SATELITE (packagePrimary=false, finalAmount=0) — uma
  // por curso restante do pacote — criadas no fulfill, dando acesso a cada curso
  // sem contar receita em duplicidade. coursePackageId aponta ao pacote comprado.
  // Em compras de curso avulso, ambos ficam null/false (fluxo inalterado).
  coursePackageId String?        @map("course_package_id")
  coursePackage   CoursePackage? @relation(fields: [coursePackageId], references: [id], onDelete: SetNull)
  packagePrimary  Boolean        @default(false) @map("package_primary")

  // Venda direta com MAIS DE UM CURSO (avulsa, sem pacote no catalogo). Mesma
  // mecanica do pacote, so que a lista de cursos e da VENDA, nao de um produto:
  // a matricula PRIMARIA carrega o Payment do valor somado e guarda aqui os
  // cursos EXTRA (o 1o fica em `courseId`). Curso unico/pacote: array vazio.
  bundleCourseIds String[] @default([]) @map("bundle_course_ids")

  // Ponteiro da SATELITE para a matricula que carrega a cobranca da compra.
  // Vale para os DOIS casos (pacote do catalogo e venda multi-curso) e e por ele
  // que a COTA DE AULAS descobre o parcelamento de uma satelite — ela nao tem
  // cobranca propria (finalAmount 0, paymentType ONE_TIME, installmentsTotal
  // null). Sem o ponteiro, o curso 2 de uma venda em 6x sairia 100% liberado ja
  // na 1a parcela. Null na primaria e na venda de curso avulso.
  //
  // O plano NAO e copiado para a satelite de proposito: `installmentsTotal` e
  // campo de COBRANCA (sweep do carne, varredura de inadimplencia) e uma copia
  // faria esses jobs tratarem a satelite como se tivesse boleto proprio.
  primaryEnrollmentId  String?      @map("primary_enrollment_id")
  primaryEnrollment    Enrollment?  @relation("EnrollmentSatellites", fields: [primaryEnrollmentId], references: [id], onDelete: SetNull)
  satelliteEnrollments Enrollment[] @relation("EnrollmentSatellites")

  // Pagamento
  paymentType    PaymentType      @map("payment_type")
  status         EnrollmentStatus @default(PENDING)
  originalAmount Decimal          @map("original_amount") @db.Decimal(10, 2)
  discountAmount Decimal          @default(0) @map("discount_amount") @db.Decimal(10, 2)
  finalAmount    Decimal          @map("final_amount") @db.Decimal(10, 2)

  // Gateway escolhido (vitrine PMB pode usar MP ou ASAAS)
  gateway PaymentGateway @default(MP)

  // Termos de rateio CONGELADOS no checkout, quando esta matricula e de um curso
  // de autoria de OUTRA unidade. Um carne de 6x paga ao longo de meses: se o
  // produtor editar a comissao no meio, as parcelas seguintes NAO podem mudar de
  // regra. Formato em src/lib/course-authoring/split.ts (SplitSnapshot).
  // Null = venda comum do catalogo PMB (sem rateio).
  authorSplitSnapshot Json? @map("author_split_snapshot")

  // Mercado Pago
  mpPreferenceId    String? @map("mp_preference_id") // preference_xxxx
  mpPaymentId       String? @map("mp_payment_id") // Pagamento unico
  mpSubscriptionId  String? @map("mp_subscription_id") // preapproval_xxxx (mensal)
  externalReference String? @map("external_reference") // Para rastreamento no webhook

  // Asaas (venda direta PMB via Asaas)
  asaasCustomerId     String? @map("asaas_customer_id")
  asaasPaymentId      String? @map("asaas_payment_id") // 1a cobranca (one-time) ou 1a parcela da subscription
  asaasSubscriptionId String? @map("asaas_subscription_id") // Subscription Asaas para cursos MONTHLY
  asaasInstallmentId  String? @map("asaas_installment_id") // id do carne (parcelamento boleto) no Asaas
  asaasInvoiceUrl     String? @map("asaas_invoice_url") @db.Text

  // Controle de mensalidades (cursos MONTHLY)
  installmentsTotal Int? @map("installments_total") // = course.monthlyMonthsMain no momento da compra
  installmentsPaid  Int  @default(0) @map("installments_paid")

  // ── Cota de aulas (trava de conclusao proporcional ao pagamento) ──────────
  // Na venda parcelada o acesso e liberado em fatias: o aluno so avanca ate
  // floor(installmentsPaid / installmentsTotal x 100)% do curso. A cota e SEMPRE
  // recalculada dos contadores acima (ver src/lib/enrollment/pace-gate.ts); os
  // campos abaixo guardam apenas o que ja foi PROPAGADO ao provedor (idempotencia
  // — nao rechamar EA/LMS a cada varredura) e o estado exibido na UI.
  paceAppliedPercent Int?      @map("pace_applied_percent") // ultima cota propagada
  paceBlockedAt      DateTime? @map("pace_blocked_at") // null = curso liberado
  // Liberacao manual da cota (SUPER_ADMIN) — desarma a trava desta matricula.
  paceExemptAt       DateTime? @map("pace_exempt_at")
  paceExemptByUserId String?   @map("pace_exempt_by_user_id") // escalar (sem FK), so auditoria

  // Matricula nascida de uma ASSINATURA (nao de uma compra avulsa). Criada sob
  // demanda, quando o assinante abre o curso pela primeira vez.
  //
  // Nasce com finalAmount 0, paymentType ONE_TIME, installmentsTotal null e SEM
  // Payment: quem carrega o dinheiro e o SubscriptionPayment do ciclo. O
  // ONE_TIME tambem a mantem FORA da cota de aulas (PACE_GATED_PAYMENT_TYPES so
  // cobre BOLETO_INSTALLMENT e MONTHLY) — assinatura nao tem parcela a
  // proporcionalizar.
  //
  // `expiresAt` fica NULL: o prazo e o da assinatura, nao os 12 meses de
  // STUDENT_ACCESS_MONTHS. O sweep de expiracao filtra `expiresAt not null`,
  // entao a matricula de assinante nao e cortada por tempo.
  studentSubscriptionId String?              @map("student_subscription_id")
  studentSubscription   StudentSubscription? @relation(fields: [studentSubscriptionId], references: [id], onDelete: SetNull)

  // Cupom
  couponId String? @map("coupon_id")
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  // Datas
  startedAt   DateTime? @map("started_at")
  expiresAt   DateTime? @map("expires_at")
  cancelledAt DateTime? @map("cancelled_at")

  // Funil de avisos do fim do prazo de 12 meses: registra quais marcos (em dias
  // antes do `expiresAt` — 60/30/15/2) ja foram notificados ao aluno. Garante
  // dedup e catch-up no cron `sweep-students-expired` mesmo se um dia for pulado.
  accessWarnDaysSent Int[] @default([]) @map("access_warn_days_sent")

  // Progresso sincronizado da plataforma parceira (cursosvinculados)
  // Match feito por NOME do curso (API nao retorna ID confiavel)
  progressPercent  Int?      @default(0) @map("progress_percent") // 0-100
  progressStatus   String?   @map("progress_status") // EM_ANDAMENTO, CONCLUIDO, AGUARDANDO
  lastLessonAt     DateTime? @map("last_lesson_at")
  progressSyncedAt DateTime? @map("progress_synced_at")

  // Matricula no LMS (provider=LMS). Retornado por POST /api/v1/enrollments,
  // usado para revogar acesso (POST /enrollments/:id/revoke). null em cursos EA.
  lmsEnrollmentId String? @map("lms_enrollment_id")

  // Acesso a plataforma de destino do LMS (curso proprio do LMS ou parceiro).
  // Vem em `partnerAccess` no 201 de POST /api/v1/enrollments. Guardado por
  // matricula porque origin/playback variam por curso. lmsSenha CIFRADA
  // (AES-256-GCM, mesmo padrao de plataformaAlunoSenha). null em cursos EA.
  lmsOrigin    String? @map("lms_origin") // "own" | chave do parceiro
  lmsPlayback  String? @map("lms_playback") // "local" | "redirect"
  lmsLogin     String? @map("lms_login")
  lmsSenha     String? @map("lms_senha") // criptografada
  lmsPortalUrl String? @map("lms_portal_url") @db.Text

  // Relacoes
  payments           Payment[]
  certificates       Certificate[]
  studentLead        StudentLead?
  boletoInstallments BoletoInstallment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([mpPaymentId])
  @@index([mpSubscriptionId])
  @@index([externalReference])
  @@index([asaasPaymentId])
  @@index([progressStatus])
  @@index([coursePackageId])
  // Satelites de uma venda multi-curso: o cancelamento da primaria arrasta as
  // satelites por este campo.
  @@index([primaryEnrollmentId])
  @@index([lmsEnrollmentId])
  // Corte de acesso ao cancelar a assinatura varre por aqui.
  @@index([studentSubscriptionId])
  // Composite: dashboards do painel filtram constantemente por
  // (tenantId + status) — dezenas de queries por load.
  @@index([tenantId, status])
  @@index([studentId, status])
  @@index([couponId], map: "enrollments_coupon_id_idx")
  @@index([tenantCourseId], map: "enrollments_tenant_course_id_idx")
  // Varredura de reavaliacao da cota (fase C do sweep do carne) — le so as
  // matriculas ja travadas, que sao poucas.
  @@index([paceBlockedAt])
  // DB-001: BI hub conta matrículas por bucket de created_at (platform-wide) e
  // por status ao longo do tempo — sem tenant líder o composto [tenantId,...]
  // não serve.
  @@index([createdAt])
  @@index([status, createdAt])
  // DB-010: índice já existe no banco desde 20260414_expand_roles — declarado
  // aqui só para eliminar o drift schema↔banco (sem migration).
  @@index([soldByUserId], map: "enrollments_sold_by_user_id_idx")
  @@map("enrollments")
}

// ============================================================
// PAGAMENTOS (cada pagamento recebido do aluno)
// ============================================================

model Payment {
  id           String     @id @default(cuid())
  tenantId     String?    @map("tenant_id") // null = vitrine principal PMB
  tenant       Tenant?    @relation(fields: [tenantId], references: [id])
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  // Vendedor (PMB_SALES ou consultor que originou)
  soldByUserId String? @map("sold_by_user_id")
  soldByUser   User?   @relation("SoldPayments", fields: [soldByUserId], references: [id])

  // Valores
  amount  Decimal        @db.Decimal(10, 2)
  type    PaymentType
  gateway PaymentGateway @default(MP)

  // Mercado Pago (nullable quando gateway=ASAAS)
  mpPaymentId    String?       @unique @map("mp_payment_id") // ID do pagamento no MP
  mpStatus       PaymentStatus @map("mp_status")
  mpPaymentType  String?       @map("mp_payment_type") // credit_card, pix, boleto, account_money
  mpStatusDetail String?       @map("mp_status_detail")

  // Asaas (nullable quando gateway=MP)
  asaasPaymentId String? @unique @map("asaas_payment_id")

  // Cupom aplicado
  couponId String? @map("coupon_id")
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  // Linhas de rateio realizadas (curso de autoria de outra unidade). Vazio na
  // esmagadora maioria dos pagamentos.
  courseSaleSplits CourseSaleSplit[]

  paidAt    DateTime? @map("paid_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([mpPaymentId])
  @@index([enrollmentId])
  // Composite: financeiro do revendedor lista pagamentos por janela
  // de data dentro do tenant — sem index composto, full scan por tenant.
  @@index([tenantId, createdAt])
  @@index([tenantId, paidAt])
  @@index([couponId], map: "payments_coupon_id_idx")
  // DB-001: approvedRevenueByBucket (BI platform-wide) filtra
  // mp_status='APPROVED' + paid_at range sem tenant líder — este composto casa
  // exatamente o WHERE.
  @@index([mpStatus, paidAt])
  // DB-010: índice já existe no banco desde 20260414_expand_roles — declarado
  // aqui só para eliminar o drift schema↔banco (sem migration).
  @@index([soldByUserId], map: "payments_sold_by_user_id_idx")
  @@map("payments")
}

// ============================================================
// RATEIO DE VENDA (curso de autoria de outra unidade)
// ============================================================

// Papel de cada parte no rateio de UMA venda.
//   PRODUCER — a unidade que PRODUZIU o curso
//   SELLER   — a unidade dona da vitrine onde a compra aconteceu
//   PLATFORM — a PMB, pela intermediacao e distribuicao
enum CourseSplitRole {
  PRODUCER
  SELLER
  PLATFORM
}

// Espelha os status de split do Asaas. A linha nasce PENDING no ato do
// pagamento e caminha pelos webhooks PAYMENT_SPLIT_*.
enum CourseSplitStatus {
  PENDING
  AWAITING_CREDIT
  DONE
  REFUSED
  CANCELLED
  REFUNDED
  // Exclusivo nosso: a parte que NAO viaja por split — fica na conta de quem
  // emitiu a cobranca (o vendedor) como resto liquido. Registrada mesmo assim
  // para que o extrato feche em 100% sem o leitor ter que fazer a subtracao.
  RETAINED
}

/// Uma linha de rateio REALIZADA, por pagamento e por papel.
///
/// Nasce na MESMA transacao do Payment (src/lib/enrollment/fulfill.ts), lida do
/// snapshot congelado em Enrollment.authorSplitSnapshot — nunca recalculada a
/// partir dos termos VIVOS do curso, senao uma edicao do produtor reescreveria
/// as parcelas ja pagas de um carne.
///
/// `@@unique([paymentId, role])` e a chave de idempotencia: a re-entrega do
/// webhook do gateway re-executa o fulfill, e a segunda passada nao pode
/// duplicar o extrato. Mesmo molde de ReferralMonthlyCommission.
model CourseSaleSplit {
  id String @id @default(cuid())

  paymentId String  @map("payment_id")
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  // Denormalizados para o extrato nao precisar de 3 joins em toda leitura.
  enrollmentId String @map("enrollment_id")
  courseId     String @map("course_id")

  role CourseSplitRole

  // null = PMB (segue a convencao de Payment.tenantId/Enrollment.tenantId, onde
  // null ja significa "vitrine principal PMB").
  beneficiaryTenantId String? @map("beneficiary_tenant_id")
  beneficiaryTenant   Tenant? @relation("CourseSplitBeneficiary", fields: [beneficiaryTenantId], references: [id], onDelete: Restrict)

  // Carteira Asaas de destino no momento da cobranca. Snapshot: a unidade pode
  // trocar de conta depois, e o extrato tem que continuar dizendo para onde o
  // dinheiro DAQUELA venda foi. Null na linha RETAINED (nao viaja).
  walletId String? @map("wallet_id")

  // Valor ESPERADO, calculado sobre o bruto. O Asaas liquida sobre o LIQUIDO
  // (depois da tarifa dele), entao o creditado costuma ser alguns centavos
  // menor — a diferenca e a fatia proporcional da tarifa. Ver split.ts.
  amount         Decimal  @db.Decimal(10, 2)
  percentApplied Decimal? @map("percent_applied") @db.Decimal(7, 4)

  // Id do split no Asaas, quando ha. Chega no webhook em additionalInfo.splitId.
  asaasSplitId  String?           @unique @map("asaas_split_id")
  status        CourseSplitStatus @default(PENDING)
  // Preenchido quando status=REFUSED (o Asaas manda o motivo).
  refusalReason String?           @map("refusal_reason")
  settledAt     DateTime?         @map("settled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([paymentId, role])
  @@index([beneficiaryTenantId, status])
  @@index([courseId])
  @@index([enrollmentId])
  @@map("course_sale_splits")
}

// Uma parcela (boleto) de um carne de venda direta (PaymentType.BOLETO_INSTALLMENT).
// A venda gera N linhas — uma por mes. No Asaas o carne e nativo (todas emitidas
// na criacao); no MP cada boleto e emitido pelo cron ~7 dias antes do vencimento
// (a 1a e emitida na hora da venda). O aluno so ve a parcela quando ela esta
// disponivel (1a sempre; demais na janela de 7 dias). Ver src/lib/installments/.
model BoletoInstallment {
  id           String     @id @default(cuid())
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  // Espelha enrollment.tenantId (null = vitrine PMB). Coluna escalar (sem FK) so
  // para escopar as varreduras do cron por unidade sem join.
  tenantId     String?    @map("tenant_id")

  number  Int // 1..N (ordem da parcela)
  amount  Decimal                 @db.Decimal(10, 2) // valor da parcela
  dueDate DateTime                @map("due_date") // vencimento
  status  BoletoInstallmentStatus @default(SCHEDULED)
  gateway PaymentGateway // MP | ASAAS (herdado do salesGateway da unidade na venda)

  // Boleto emitido
  invoiceUrl    String?   @map("invoice_url") @db.Text // link do boleto (Asaas invoiceUrl / MP external_resource_url)
  digitableLine String?   @map("digitable_line") // linha digitavel / codigo de barras
  generatedAt   DateTime? @map("generated_at") // quando o boleto foi emitido

  // Ids no gateway (um pagamento por parcela)
  mpPaymentId    String? @unique @map("mp_payment_id")
  asaasPaymentId String? @unique @map("asaas_payment_id")

  paidAt DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([enrollmentId, number])
  @@index([enrollmentId])
  @@index([status, dueDate])
  @@index([tenantId])
  @@map("boleto_installments")
}

// ============================================================
// CUPONS DE DESCONTO
// ============================================================

model Coupon {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id") // null = cupom da vitrine principal PMB
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Auditoria + cap por papel
  createdByUserId String?   @map("created_by_user_id")
  createdByUser   User?     @relation("CreatedCoupons", fields: [createdByUserId], references: [id])
  createdByRole   UserRole? @map("created_by_role")

  code          String // Codigo do cupom (ex: PROMO20)
  discountType  DiscountType @map("discount_type")
  discountValue Decimal      @map("discount_value") @db.Decimal(10, 2)

  // Limites
  maxUses    Int?     @map("max_uses") // null = ilimitado
  usedCount  Int      @default(0) @map("used_count")
  validFrom  DateTime @map("valid_from")
  validUntil DateTime @map("valid_until")
  isActive   Boolean  @default(true) @map("is_active")

  // Relacoes
  enrollments   Enrollment[]
  subscriptions StudentSubscription[]
  payments      Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@index([createdByUserId], map: "coupons_created_by_user_id_idx")
  @@map("coupons")
}

// ============================================================
// MENSALIDADES DOS REVENDEDORES (via Asaas)
// ============================================================

model TenantPayment {
  id       String @id @default(cuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Asaas
  // ATENCAO: numa mensalidade PARCELADA no cartao esta coluna guarda o id do
  // PARCELAMENTO (`ins_...`), nao o de uma cobranca — o parcelamento substitui a
  // cobranca original, que e removida do Asaas. Por isso `getPayment` nao
  // resolve esse id e a linha nao oferece "Pagar agora".
  asaasPaymentId String  @unique @map("asaas_payment_id") // pay_xxxx (ou ins_xxxx num parcelamento)
  amount         Decimal @db.Decimal(10, 2)
  billingType    String? @map("billing_type") // PIX, BOLETO, CREDIT_CARD

  // Mensalidade paga de forma PARCELADA no cartao. UMA linha representa o
  // parcelamento inteiro: `amount` e o valor cheio da mensalidade, ja autorizado
  // no cartao. As parcelas 2..N NAO viram linhas novas — criariam receita
  // duplicada no financeiro; elas so avancam `installmentPaidCount`.
  installmentId      String?  @map("installment_id") // ins_xxxx
  installmentCount   Int?     @map("installment_count") // N parcelas
  // Ids das parcelas JA liquidadas. E a UNICA fonte da contagem ("3 de 6" e o
  // tamanho do array) e ao mesmo tempo a chave de idempotencia: o Asaas
  // reentrega webhook, e um contador puro somaria a mesma parcela duas vezes,
  // exibindo "7 de 6". Guardar os ids torna a re-entrega um no-op natural.
  installmentPaidIds String[] @default([]) @map("installment_paid_ids")

  // Links de pagamento
  invoiceUrl  String? @map("invoice_url") @db.Text
  bankSlipUrl String? @map("bank_slip_url") @db.Text

  // Status
  status  String // PENDING, CONFIRMED, RECEIVED, OVERDUE, REFUNDED, etc.
  dueDate DateTime  @map("due_date")
  paidAt  DateTime? @map("paid_at")
  /// FATO: quando o CLIENTE pagou (`clientPaymentDate` do Asaas). No cartao o
  /// Asaas credita em D+32, entao esta data e diferente de `paidAt`.
  clientPaidAt DateTime? @map("client_paid_at")
  /// REGRA: a que MES a mensalidade pertence = max(vencimento, pagamento do
  /// cliente). Antecipar nao move a fatura de mes; atrasar move. So o motor de
  /// comissao consome. `paidAt` continua sendo CAIXA (churn, blacklist,
  /// financeiro, inadimplencia). Ver src/lib/asaas/competencia.ts.
  competenceAt DateTime? @map("competence_at")

  // Indicacao (1-nivel)
  referralCommission ReferralCommission?
  // Desconto aplicado vindo de um ReferralPayout (DESCONTO_MENSALIDADE)
  appliedPayoutId    String?             @unique @map("applied_payout_id")
  appliedPayout      ReferralPayout?     @relation("AppliedToTenantPayment", fields: [appliedPayoutId], references: [id])

  // Lembretes de vencimento ja disparados (D-5 / D-2 / D-0). Ver
  // TenantPaymentReminder — e o livro-caixa de idempotencia do cron.
  reminders TenantPaymentReminder[]

  // Gestao financeira manual (admin marca pago/anota)
  notes          String?   @map("notes") @db.Text // anotacoes do financeiro
  markedPaidAt   DateTime? @map("marked_paid_at") // quando admin marcou manualmente como pago

  // ── ESTORNO registrado manualmente ──
  // O dinheiro voltou para a unidade (arrependimento em 7 dias, cobranca
  // indevida). A mensalidade estornada NAO entra na comissao de indicacao: o
  // motor filtra por status pago, e o estorno leva a linha para `REFUNDED`.
  // O comprovante e OBRIGATORIO — e a prova de que o dinheiro saiu.
  refundedAt     DateTime? @map("refunded_at")
  refundReason   String?   @map("refund_reason") @db.Text
  /// PATH no bucket privado (nunca URL publica), como o comprovante de saque.
  refundProofUrl String?   @map("refund_proof_url") @db.Text
  refundedById   String?   @map("refunded_by_id")
  refundedBy     User?     @relation("RefundedTenantPayments", fields: [refundedById], references: [id])
  markedPaidById String?   @map("marked_paid_by_id") // userId do admin que marcou
  markedPaidBy   User?     @relation("MarkedTenantPayments", fields: [markedPaidById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@index([status])
  @@index([dueDate])
  // Composite: relatórios financeiros do admin filtram por tenant +
  // janela de data (createdAt/dueDate). Status incluso pra cobrir
  // queries tipo "todos OVERDUE deste tenant em X mês".
  @@index([tenantId, status, dueDate])
  @@index([tenantId, createdAt])
  // O motor de comissao varre a competencia por (tenant, competence_at).
  @@index([tenantId, competenceAt])
  // DB-010: índice já existe no banco desde 20260522_financial_manual_management
  // — declarado aqui só para eliminar o drift schema↔banco (sem migration).
  @@index([markedPaidById], map: "tenant_payments_marked_paid_by_idx")
  // Webhook das parcelas 2..N casa a linha-pai por aqui.
  @@index([installmentId])
  @@map("tenant_payments")
}

/**
 * Lembretes de vencimento da mensalidade da unidade (cron
 * `tenant-payment-reminders`), um por cobranca e por janela: 5 dias antes,
 * 2 dias antes e no proprio dia do vencimento.
 * POR QUE EXISTE: e o livro-caixa de idempotencia. O cron pode rodar mais de
 * uma vez no mesmo dia (re-tentativa do pg_net, execucao manual, deploy no meio
 * da janela) e a unidade nao pode receber o mesmo aviso duas vezes — nem in-app,
 * nem por email. A linha e gravada ANTES do disparo: quem conseguiu inserir e o
 * unico dono daquele aviso.
 */
model TenantPaymentReminder {
  tenantPaymentId String        @map("tenant_payment_id")
  tenantPayment   TenantPayment @relation(fields: [tenantPaymentId], references: [id], onDelete: Cascade)
  /**
   * Dias entre o disparo e o vencimento: 5, 2 ou 0.
   */
  offsetDays      Int           @map("offset_days")
  sentAt          DateTime      @default(now()) @map("sent_at")

  @@id([tenantPaymentId, offsetDays])
  @@index([sentAt])
  @@map("tenant_payment_reminders")
}

// ============================================================
// LOG DE WEBHOOKS (auditoria)
// ============================================================

model WebhookLog {
  id       String  @id @default(cuid())
  tenantId String? @map("tenant_id") // Pode ser null se for webhook do Asaas (admin)
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  source    WebhookSource
  eventType String        @map("event_type") // PAYMENT_RECEIVED, payment.updated, etc.
  payload   Json // Payload completo recebido
  headers   Json? // Headers relevantes (para debug)

  // Idempotencia de webhooks de ENTRADA (LMS): X-PMB-Event-Id estavel entre
  // retries. Unique parcial (NULLs nao colidem) — webhooks MP/Asaas ficam null.
  externalEventId String? @unique @map("external_event_id")

  // Processamento
  processed   Boolean   @default(false)
  processedAt DateTime? @map("processed_at")
  error       String?   @db.Text // Mensagem de erro se falhou

  createdAt DateTime @default(now()) @map("created_at")

  @@index([source, eventType])
  @@index([processed])
  @@index([createdAt])
  @@map("webhook_logs")
}

// ============================================================
// LEADS (captacao de interesse de revendedores)
// ============================================================

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

// ============================================================
// INDICACOES (referral 1-nivel)
// ============================================================

enum ReferralCommissionStatus {
  PENDING // Aguardando data de liberacao (dia 20 do mes seguinte)
  AVAILABLE // Liberada para saque, ainda nao paga
  PAID // Paga ao indicador
  CANCELLED // Estorno da mensalidade base
}

enum ReferralPayoutMethod {
  ASAAS_PIX // PIX via Asaas Transfer
  DESCONTO_MENSALIDADE // Aplicado como desconto na proxima TenantPayment
  MANUAL // Pago manualmente pelo admin (registro)
}

enum ReferralPayoutStatus {
  REQUESTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

// Motor de comissao por faixas (configuravel) — coexiste com o motor legado.
enum CommissionMode {
  PER_PAYMENT_PERCENT // Legado: % da mensalidade, por pagamento recebido
  MONTHLY_TIERED // Por faixas: valor/percentual por faixa, no fechamento mensal
}

enum CommissionBracketBasis {
  NEW_REFERRALS_MONTH // Faixa pelo nº de novas revendas indicadas no mes
  ACTIVE_UNITS // Faixa pelo nº de unidades ativas do indicador
}

enum CommissionRateType {
  FIXED // Valor fixo (R$) por unidade da base de pagamento
  PERCENT // Percentual da mensalidade de cada unidade da base de pagamento
}

enum CommissionPayoutBase {
  ALL_ACTIVE // Valor/percentual incide sobre TODAS as unidades ativas
  REFERRED_THIS_MONTH // Incide apenas sobre as unidades indicadas naquele mes
  PAID_THIS_MONTH // Incide apenas sobre as unidades que PAGARAM mensalidade no mes
}

// ============================================================
// CERTIFICADOS
// ============================================================

enum CertificateSource {
  AUTO // Emitido automaticamente via cron de progresso
  MANUAL_ADMIN // Emitido manualmente pelo admin
  MANUAL_RESELLER // Emitido manualmente pelo revendedor
}

enum CertificateLayout {
  CLASSIC
  MODERN
  MINIMAL
}

model Lead {
  id          String     @id @default(cuid())
  email       String
  companyName String     @map("company_name")
  phone       String
  status      LeadStatus @default(NEW)

  // Segmentacao do interesse (antes serializado em `notes`)
  plan   String? // plano de interesse: "Profissionaliza" / "PRO"
  city   String?
  state  String? @db.VarChar(4)
  source String? // origem do lead (ex: "/seja-revendedor")

  // Captacao completa (form /lp-revenda2): CPF do interessado e o subdominio
  // (slug) que ele deseja para a vitrine. Sao apenas a INTENCAO capturada no
  // lead — a unicidade/reserva do slug e validada na conversao em unidade.
  // Ambos opcionais (o form /seja-revendedor classico nao os envia).
  cpf  String?
  slug String?

  // Quando converter em revendedor, liga ao tenant criado
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation("LeadConvertedTenant", fields: [tenantId], references: [id])

  // Indicacao: revendedor que indicou este interessado (capturado do ?ref na
  // pagina /seja-revendedor ou do cookie pmb_referral). Preserva a atribuicao
  // mesmo quando a conversao e feita pela equipe — nao depende do cookie do admin.
  referrerTenantId String? @map("referrer_tenant_id")
  referrer         Tenant? @relation("LeadReferrer", fields: [referrerTenantId], references: [id])

  // Vendedor de revenda (PMB_REVENDA_SALES) dono deste lead. Atribuido por rodizio
  // (SystemSettings.leadRevendaAutoAssign) ou manualmente pelo admin/gerente.
  // Na conversao em unidade, vira o Tenant.salesUserId.
  ownerUserId String? @map("owner_user_id")
  owner       User?   @relation("LeadOwner", fields: [ownerUserId], references: [id])

  // Ordem dentro da coluna do kanban (drag-and-drop reordena). Menor = topo.
  columnOrder Int @default(0) @map("column_order")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([status, columnOrder])
  @@index([email])
  @@index([createdAt])
  @@index([referrerTenantId])
  @@index([ownerUserId])
  @@map("leads")
}

// ============================================================
// ATENDIMENTO — Contato publico + Suporte do aluno (caixa por dono)
// ============================================================
// Diferente de Lead (B2B revenda) e StudentLead (interesse em curso), o
// ContactMessage e a caixa de atendimento de quem ja e dono da relacao:
// PMB (tenantId null) ou a unidade (tenantId). Recebe tanto contato publico
// anonimo (kind=CONTACT) quanto chamados de aluno logado (kind=STUDENT_SUPPORT).

enum ContactMessageKind {
  CONTACT // visitante (form publico /contato ou storefront da unidade)
  STUDENT_SUPPORT // aluno logado abriu chamado
}

enum ContactMessageStatus {
  OPEN
  RESOLVED
}

model ContactMessage {
  id       String  @id @default(cuid())
  // null = PMB institucional · senao a unidade (tenant) dona da relacao
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  kind   ContactMessageKind
  status ContactMessageStatus @default(OPEN)

  // Contato (snapshot — anonimo no caso de visitante)
  nome     String
  email    String?
  telefone String?
  assunto  String?
  mensagem String  @db.Text

  // Preenchido apenas quando kind=STUDENT_SUPPORT
  studentId String?  @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  // Proveniencia / LGPD
  source    String? // "/contato", "loja:{slug}", "aluno"
  ipAddress String? @map("ip_address")
  userAgent String? @map("user_agent") @db.Text

  // Resolucao
  resolvedAt       DateTime? @map("resolved_at")
  resolvedByUserId String?   @map("resolved_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, status, createdAt])
  @@index([studentId])
  @@map("contact_messages")
}

// ============================================================
// CONFIGURACOES GLOBAIS DO SISTEMA (singleton id="default")
// ============================================================

// ============================================================
// NOTIFICACOES IN-APP
// ============================================================

enum NotificationLevel {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationAudience {
  USER // entregue para um User especifico (User.id)
  STUDENT // entregue para um Student especifico (Student.id)
  TENANT // entregue para todos os usuarios do tenant
  ROLE // entregue para todos os Users com determinado UserRole
}

model Notification {
  id         String               @id @default(cuid())
  audience   NotificationAudience
  // alvo concreto (depende de audience):
  userId     String?              @map("user_id")
  studentId  String?              @map("student_id")
  tenantId   String?              @map("tenant_id")
  roleTarget UserRole?            @map("role_target")

  level    NotificationLevel @default(INFO)
  title    String
  body     String?           @db.Text
  // categoria livre para filtros (ex: "payment", "enrollment", "tenant", "support")
  category String?
  // link opcional dentro do app
  href     String?

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([studentId, readAt])
  @@index([tenantId, readAt])
  @@index([roleTarget, readAt])
  @@index([audience, createdAt])
  @@map("notifications")
}

// Assinatura de push do navegador (Web Push API). Cada par (user_id|student_id,
// endpoint) e unico — um mesmo usuario pode ter varios dispositivos/browsers.
// p256dh + auth sao as chaves de criptografia retornadas pelo PushSubscription
// do navegador (RFC 8291). Pertence ao User OU Student (mutuamente exclusivo).
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  studentId    String?  @map("student_id")
  // tenantId é preenchido quando a assinatura nasce no contexto de uma vitrine
  // de revendedor (visitante anônimo ou logado). Permite segmentar campanhas de
  // push por unidade. NULL = site institucional PMB / contexto sem tenant.
  tenantId     String?  @map("tenant_id")
  endpoint     String   @db.Text
  p256dh       String   @db.Text
  auth         String   @db.Text
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  lastUsedAt   DateTime @default(now()) @map("last_used_at")
  failureCount Int      @default(0) @map("failure_count")

  @@unique([userId, endpoint])
  @@unique([studentId, endpoint])
  @@index([userId])
  @@index([studentId])
  @@index([tenantId])
  @@index([endpoint])
  @@map("push_subscriptions")
}

// Preferencias por categoria (User OU Student). Quando ausente, defaults
// permitem todos os canais. Categorias livres: payment, enrollment, lead,
// tenant, tenant-billing, sale, support.
model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  studentId String?  @map("student_id")
  category  String
  inApp     Boolean  @default(true) @map("in_app")
  email     Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@unique([studentId, category])
  @@index([userId])
  @@index([studentId])
  @@map("notification_preferences")
}

// Trilha de auditoria de TODO envio de email (sucesso e falha). Antes disso, as
// falhas iam só para o stdout (Pino) e o dono não tinha como saber o que não foi
// entregue nem reenviar. Gravado best-effort por `sendEmail` — nunca derruba o
// envio. `status` = SENT | FAILED; `provider` = smtp | resend; `error` guarda a
// mensagem quando FAILED. `tenantId` quando o envio nasce no contexto de uma
// unidade (para diagnóstico por revenda).
model EmailLog {
  id        String   @id @default(cuid())
  to        String   @db.Text
  subject   String   @db.Text
  template  String
  status    String // SENT | FAILED
  provider  String // smtp | resend
  error     String?  @db.Text
  tenantId  String?  @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([to])
  @@index([tenantId])
  @@map("email_logs")
}

// Kill-switch global por (target, categoria) das notificacoes automaticas.
// Quando enabled=false, `createNotification` ignora aquela combinacao sem
// criar registro nem enviar push. NotificationPreference por usuario
// continua valendo em cima do que estiver enabled aqui.
//
// target = TENANT | STUDENT | ADMIN — derivado da audience:
//   STUDENT -> STUDENT
//   TENANT  -> TENANT
//   ROLE    -> ADMIN
//   USER    -> ADMIN (broadcasts manuais e admin tooling)
model NotificationCategoryConfig {
  target       String // TENANT | STUDENT | ADMIN
  category     String
  label        String
  description  String?           @db.Text
  enabled      Boolean           @default(true)
  defaultLevel NotificationLevel @default(INFO) @map("default_level")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  @@id([target, category])
  @@map("notification_category_configs")
}

// Override por revenda: cada tenant pode desligar categorias automaticas
// (target=STUDENT) que vao para os alunos dele. Combinacao com a config
// global:
//   global=FALSE                      -> bloqueia para todos
//   global=TRUE + override=FALSE       -> bloqueia so neste tenant
//   global=TRUE + sem override         -> envia
model TenantNotificationOverride {
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category  String
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, category])
  @@index([tenantId])
  @@map("tenant_notification_overrides")
}

/**
 * Batimento dos jobs agendados. Uma linha por job (`jobName` = ultimo segmento
 * da rota, ex.: "sync-progresso").
 * POR QUE EXISTE: os crons rodam no pg_cron do Supabase chamando nossas rotas
 * por HTTP. Se a ponte quebra (foi o que houve entre 30/04 e 10/06 de 2026,
 * quando o pg_net mudou de schema e TODOS os jobs falharam), nada avisa — a
 * falha passou seis semanas despercebida. `cron.job_run_details` so prova que o
 * Postgres disparou, nao que a rota rodou. Esta tabela e a prova do lado da
 * aplicacao, e o que permite a tela do admin dizer "nao roda ha X horas".
 */
model CronRun {
  jobName   String   @id @map("job_name")
  lastRunAt DateTime @map("last_run_at")
  runCount  Int      @default(0) @map("run_count")

  @@map("cron_runs")
}

model SystemSettings {
  id                          String         @id @default("default")
  pmbDirectSaleGateway        PaymentGateway @default(MP) @map("pmb_direct_sale_gateway")
  pmbMpAccessTokenEnc         String?        @map("pmb_mp_access_token_enc") @db.Text
  // Parcelamento sem juros das vendas diretas da PMB (vitrine PMB, conta MP da
  // PMB). Espelha Tenant.interestFreeInstallments mas para a PMB. Teto 12x.
  pmbInterestFreeInstallments Int            @default(1) @map("pmb_interest_free_installments")

  // Teto PADRAO de parcelas no cartao para as mensalidades da unidade (revenda
  // pagando a PMB) depois da 1a. Cada unidade pode sobrescrever em
  // Tenant.monthlyMaxInstallments. 1 = sem parcelamento. Teto duro 21x (limite
  // do Asaas em POST /installments/).
  tenantMonthlyMaxInstallments Int     @default(12) @map("tenant_monthly_max_installments")
  lastCatalogSyncJson          String? @map("last_catalog_sync_json") @db.Text

  // Cursor incremental do delta sync do LMS (GET /api/v1/day-update?since=).
  // Guardamos o `generatedAt` da ultima resposta processada com sucesso e o
  // enviamos como `since` na proxima execucao. null => proximo run faz export
  // completo (1a carga).
  lmsDayUpdateCursor   String?   @map("lms_day_update_cursor")
  lmsDayUpdateSyncedAt DateTime? @map("lms_day_update_synced_at")

  // Pixels de rastreamento da PMB: self (site/vitrine PMB) + global (todas as vitrines).
  pixelsSelf   Json? @map("tracking_pixels_self")
  pixelsGlobal Json? @map("tracking_pixels_global")

  // Distribuicao automatica dos leads de revenda (B2B) entre os vendedores de
  // revenda ativos (PMB_REVENDA_SALES). Espelha leadAutoAssign/cursor do Tenant
  // mas no nivel PMB (leads de /seja-revendedor nao tem tenant). Quando ligado,
  // cada lead novo nasce com ownerUserId apontando para o proximo vendedor na
  // fila. Desligado = atribuicao manual. Ver src/lib/automation/assign.ts.
  leadRevendaAutoAssign   Boolean @default(false) @map("lead_revenda_auto_assign")
  leadRevendaAssignCursor Int     @default(0) @map("lead_revenda_assign_cursor")

  // Indicacoes
  referralEnabled             Boolean @default(true) @map("referral_enabled")
  defaultReferralPercent      Decimal @default(5.00) @map("default_referral_percent") @db.Decimal(5, 2) // 5%
  referralMinPayout           Decimal @default(50.00) @map("referral_min_payout") @db.Decimal(10, 2) // R$50
  // Minimo padrao de indicacoes ATIVAS para uma unidade comecar a receber
  // comissao de recorrencia. Override por unidade em Tenant.referralMinReferrals.
  defaultReferralMinReferrals Int     @default(3) @map("default_referral_min_referrals")
  // Primeira competencia ("AAAA-MM") que pertence ao motor unico. Competencias
  // ANTERIORES ficaram com o ledger legado (ReferralCommission) e ja foram
  // liquidadas — reapura-las criaria uma segunda comissao sobre o mesmo mes.
  // Null = sem corte (apura tudo). Ver src/lib/referrals/monthly.ts.
  commissionUnifiedSince      String? @map("commission_unified_since")
  // Janela mensal: comissoes referentes a TenantPayments pagos no mes M
  // ficam AVAILABLE no dia X do mes M+1 (referralPayoutDay).
  referralPayoutDay           Int     @default(20) @map("referral_payout_day") // dia do mes do pagamento (1-20; cron libera no dia 20)

  // Motor de comissao por faixas (padrao global). PER_PAYMENT_PERCENT preserva o
  // comportamento legado (escala por tempo + referralPercent + defaultReferralPercent).
  // MONTHLY_TIERED calcula no fechamento do mes pelas faixas abaixo. Override por
  // unidade em Tenant.commission*. Ver src/lib/referrals/rules.ts.
  commissionMode         CommissionMode         @default(PER_PAYMENT_PERCENT) @map("commission_mode")
  commissionBracketBasis CommissionBracketBasis @default(NEW_REFERRALS_MONTH) @map("commission_bracket_basis")
  commissionRateType     CommissionRateType     @default(FIXED) @map("commission_rate_type")
  commissionPayoutBase   CommissionPayoutBase   @default(ALL_ACTIVE) @map("commission_payout_base")
  // Faixas ordenadas: [{ "upTo": 10, "value": 100 }, { "upTo": 30, "value": 150 }, { "upTo": null, "value": 200 }]
  // value = R$ por unidade (FIXED) ou % da mensalidade (PERCENT); upTo null = faixa final sem teto.
  commissionBrackets     Json?                  @map("commission_brackets")
  // Plano de comissao MULTI-FASE padrao da rede (global). Mesma forma do
  // Tenant.commissionPlan. Quando preenchido, e o "plano padrao": indicadores
  // sem plano/override proprio seguem estas fases. Vazio => cai nos campos
  // commission* singulares acima. Ver src/lib/referrals/rules.ts.
  commissionPlan         Json?                  @map("commission_plan")

  // ── Cota de aulas (trava proporcional ao pagamento) ──────────────────────
  // Interruptor global. Sobe DESLIGADO: liga-se primeiro numa unidade
  // (Tenant.paceGateEnabled) e so depois na rede toda.
  paceGateEnabled Boolean @default(false) @map("pace_gate_enabled")
  // Politica do corte na plataforma de aulas. O `status` do aluno na EA e por
  // LOGIN, nao por curso — e 28,6% dos logins tem mais de um curso ativo
  // (medido em 2026-07-22). Cortar o login por causa da cota de UM curso
  // derrubaria cursos ja pagos.
  //   false (padrao): so corta quando TODAS as matriculas do login estao
  //                   travadas pela cota. Zero colateral; nos demais casos
  //                   sobra a trava de certificado, que ja impede a conclusao.
  //   true  (estrito): corta assim que qualquer matricula bate a cota.
  paceGateStrict  Boolean @default(false) @map("pace_gate_strict")

  // Certificados
  certificateMinPercent Int     @default(80) @map("certificate_min_percent") // % minimo na plataforma p/ auto-emissao
  certificateAutoIssue  Boolean @default(true) @map("certificate_auto_issue")
  certificateRequireCpf Boolean @default(false) @map("certificate_require_cpf") // se true, nao emite sem CPF
  // Logo do Grupo Bolsa Mais Brasil (aparece em TODOS os certificados — PMB e unidade)
  groupLogoUrl          String? @map("group_logo_url")
  groupName             String  @default("Grupo Bolsa Mais Brasil") @map("group_name")

  // Unidade Tecnica do site PMB institucional (profissionalizamaisbrasil.com.br)
  tecnicaEnabled Boolean @default(false) @map("tecnica_enabled")
  tecnicaUrl     String? @map("tecnica_url")
  tecnicaLabel   String? @map("tecnica_label")
  tecnicaCourses Json?   @map("tecnica_courses")

  // EJA do site PMB institucional + banner padronizado para TODA a rede.
  // ejaBannerImageUrl e a imagem unica do banner (herdada por todas as vitrines);
  // ejaUrl/ejaLabel sao o link/rotulo do proprio site PMB. As unidades herdam a
  // imagem e definem o proprio link em Tenant.ejaUrl.
  ejaEnabled              Boolean @default(false) @map("eja_enabled")
  ejaUrl                  String? @map("eja_url")
  ejaLabel                String? @map("eja_label")
  // Banner da seção EJA — só a imagem (sem texto/overlay). Duas versões
  // padronizadas pela rede: desktop e mobile. Mobile cai no desktop se vazio.
  ejaBannerImageUrl       String? @map("eja_banner_image_url")
  ejaBannerImageUrlMobile String? @map("eja_banner_image_url_mobile")

  // Modulo Automacao do site PMB institucional. Espelha os campos
  // `automation*`/`wa*` do Tenant, mas para a vitrine PMB (sistema mae).
  // Default TRUE: no sistema mae o modulo vem sempre ligado; admin nao
  // precisa "habilitar" — so configurar a conexao WA. Em contraste,
  // unidades (Tenant.automationEnabled) tem default FALSE e o admin
  // ativa por revendedor no /admin/revendedores/[id].
  pmbAutomationEnabled   Boolean   @default(true) @map("pmb_automation_enabled")
  pmbWaSessionName       String?   @unique @map("pmb_wa_session_name")
  pmbWaConnectedPhone    String?   @unique @map("pmb_wa_connected_phone")
  pmbWaStatus            String    @default("DISCONNECTED") @map("pmb_wa_status")
  pmbWaStatusUpdatedAt   DateTime? @map("pmb_wa_status_updated_at")
  pmbAbandonedAfterHours Int       @default(24) @map("pmb_abandoned_after_hours")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================
// INDICACOES — COMISSOES (1-nivel)
// ============================================================
// Regra: ReferralCommission so e criada se Tenant.referrerTenantId != null.
// NUNCA olhamos referrer.referrerTenantId — impossivel virar multi-nivel.
// availableAt = dia X (SystemSettings.referralPayoutDay) do mes seguinte ao paidAt da TenantPayment.

model ReferralCommission {
  id               String @id @default(cuid())
  referrerTenantId String @map("referrer_tenant_id")
  referrer         Tenant @relation("ReferrerCommissions", fields: [referrerTenantId], references: [id], onDelete: Cascade)
  referredTenantId String @map("referred_tenant_id")
  referred         Tenant @relation("ReferredCommissions", fields: [referredTenantId], references: [id], onDelete: Cascade)

  tenantPaymentId String        @unique @map("tenant_payment_id")
  tenantPayment   TenantPayment @relation(fields: [tenantPaymentId], references: [id], onDelete: Cascade)

  baseAmount Decimal                  @map("base_amount") @db.Decimal(10, 2)
  percent    Decimal                  @db.Decimal(5, 2) // snapshot do % aplicado
  amount     Decimal                  @db.Decimal(10, 2) // baseAmount * percent / 100
  status     ReferralCommissionStatus @default(PENDING)

  availableAt  DateTime  @map("available_at") // dia X do mes seguinte ao paidAt
  paidAt       DateTime? @map("paid_at")
  cancelledAt  DateTime? @map("cancelled_at")
  cancelReason String?   @map("cancel_reason")

  // Vinculo com o payout que liquidou esta comissao (quando paga)
  payoutId String?         @map("payout_id")
  payout   ReferralPayout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([referrerTenantId, status])
  @@index([referredTenantId])
  @@index([status, availableAt])
  @@index([payoutId])
  // DB-001: BI indicacoes-comissoes agrega por range de created_at.
  @@index([createdAt])
  @@map("referral_commissions")
}

// ============================================================
// INDICACOES — SAQUES (payout)
// ============================================================

model ReferralPayout {
  id               String @id @default(cuid())
  referrerTenantId String @map("referrer_tenant_id")
  referrer         Tenant @relation(fields: [referrerTenantId], references: [id], onDelete: Cascade)

  amount Decimal              @db.Decimal(10, 2)
  method ReferralPayoutMethod @default(ASAAS_PIX)
  status ReferralPayoutStatus @default(REQUESTED)

  // Snapshot do PIX no momento do saque (se method = ASAAS_PIX)
  pixKey     String? @map("pix_key")
  pixKeyType String? @map("pix_key_type")

  asaasTransferId String? @map("asaas_transfer_id")
  failureReason   String? @map("failure_reason")
  notes           String? @db.Text

  // Gestao financeira manual (admin marca/anota)
  markedPaidById String? @map("marked_paid_by_id")
  markedPaidBy   User?   @relation("MarkedReferralPayouts", fields: [markedPaidById], references: [id])

  // Comprovante de pagamento do saque — anexado pelo Financeiro, visivel para a
  // revenda em /painel/indicacoes. Arquivo no Supabase Storage (URL publica).
  proofUrl          String?   @map("proof_url") @db.Text
  proofUploadedAt   DateTime? @map("proof_uploaded_at")
  proofUploadedById String?   @map("proof_uploaded_by_id")
  proofUploadedBy   User?     @relation("UploadedReferralProofs", fields: [proofUploadedById], references: [id])

  // Se method = DESCONTO_MENSALIDADE, a TenantPayment alvo
  appliedToTenantPayment TenantPayment? @relation("AppliedToTenantPayment")

  // Comissoes liquidadas por este payout (motor legado por pagamento)
  commissions        ReferralCommission[]
  // Comissoes mensais por faixas liquidadas por este payout (motor MONTHLY_TIERED)
  monthlyCommissions ReferralMonthlyCommission[]

  requestedAt DateTime  @default(now()) @map("requested_at")
  // Data PREVISTA de liberacao (a maior `availableAt` entre as comissoes deste
  // payout). Desde a antecipacao, a lista de pagamento nasce no dia 1 com
  // comissoes que so serao liberadas no dia X — sem esta coluna o financeiro
  // nao teria como distinguir "vence dia 20" de "ja venceu".
  dueAt       DateTime? @map("due_at")
  processedAt DateTime? @map("processed_at")
  paidAt      DateTime? @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([referrerTenantId, status])
  @@index([status, requestedAt])
  @@index([proofUploadedById], map: "referral_payouts_proof_uploaded_by_id_idx")
  // DB-010: índice já existe no banco desde 20260522_financial_manual_management
  // — declarado aqui só para eliminar o drift schema↔banco (sem migration).
  @@index([markedPaidById], map: "referral_payouts_marked_paid_by_idx")
  @@map("referral_payouts")
}

// ============================================================
// INDICACOES — COMISSAO MENSAL POR FAIXAS (motor MONTHLY_TIERED)
// ============================================================

// Comissao agregada de UM mes para UM indicador, calculada pelo motor por faixas
// no fechamento. Separada de ReferralCommission (que e por mensalidade
// individual) porque aqui o valor incide sobre a carteira, nao sobre 1 pagamento.
// Idempotente por (referrerTenantId, period). Liquidada via ReferralPayout, igual
// ao motor legado (transferencia manual + comprovante para dar baixa).
model ReferralMonthlyCommission {
  id               String @id @default(cuid())
  referrerTenantId String @map("referrer_tenant_id")
  referrer         Tenant @relation("ReferrerMonthlyCommissions", fields: [referrerTenantId], references: [id], onDelete: Cascade)

  // Mes de competencia no formato "AAAA-MM".
  period String @map("period")

  // Snapshot da regra aplicada (auditavel; edicoes futuras nao mudam o passado).
  mode         CommissionMode         @map("mode")
  bracketBasis CommissionBracketBasis @map("bracket_basis")
  rateType     CommissionRateType     @map("rate_type")
  payoutBase   CommissionPayoutBase   @map("payout_base")

  bracketIndex  Int     @map("bracket_index") // indice (0-based) da faixa atingida
  bracketCount  Int     @map("bracket_count") // contagem que determinou a faixa
  rate          Decimal @db.Decimal(10, 2) // R$ por unidade (FIXED) ou % (PERCENT)
  unitCount     Int     @map("unit_count") // nº de unidades da base de pagamento
  baseSum       Decimal @map("base_sum") @db.Decimal(10, 2) // soma das mensalidades (PERCENT) ou 0 (FIXED)
  amount        Decimal @db.Decimal(10, 2) // valor final da comissao do mes
  linesSnapshot Json?   @map("lines_snapshot") // quebra por unidade p/ demonstrativo

  status       ReferralCommissionStatus @default(PENDING)
  availableAt  DateTime                 @map("available_at")
  paidAt       DateTime?                @map("paid_at")
  cancelledAt  DateTime?                @map("cancelled_at")
  cancelReason String?                  @map("cancel_reason")

  payoutId String?         @map("payout_id")
  payout   ReferralPayout? @relation(fields: [payoutId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([referrerTenantId, period])
  @@index([referrerTenantId, status])
  @@index([status, availableAt])
  @@index([payoutId])
  // DB-001: BI indicacoes-comissoes agrega por range de created_at.
  @@index([createdAt])
  @@map("referral_monthly_commissions")
}

// ============================================================
// CERTIFICADOS — TEMPLATES
// ============================================================
// 1 template por tenant (revendedor). 1 template global PMB (tenantId = null).
// Tres layouts disponiveis: CLASSIC, MODERN, MINIMAL.

model CertificateTemplate {
  id       String  @id @default(cuid())
  tenantId String? @unique @map("tenant_id") // null = template PMB padrao
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  layout        CertificateLayout @default(CLASSIC)
  // Imagem de fundo do certificado (em destaque). Path no Supabase Storage.
  backgroundUrl String?           @map("background_url")
  // Logo da unidade (em destaque, sobre o fundo). Path no Supabase Storage.
  logoUrl       String?           @map("logo_url")
  // Selo / brasao secundario (opcional)
  sealUrl       String?           @map("seal_url")
  // Imagem de assinatura digital
  signatureUrl  String?           @map("signature_url")

  // Cores override (opcionais; defaults pegam tenant.primaryColor)
  primaryColor   String? @map("primary_color")
  secondaryColor String? @map("secondary_color")

  // Texto do certificado com placeholders:
  // {nome}, {cpf}, {curso}, {carga_horaria}, {data_conclusao}, {codigo}, {unidade}
  titleText  String  @default("CERTIFICADO DE CONCLUSAO") @map("title_text")
  bodyText   String  @default("Certificamos que {nome} concluiu com aproveitamento o curso de {curso}, com carga horaria de {carga_horaria}, em {data_conclusao}.") @map("body_text") @db.Text
  footerText String? @map("footer_text") @db.Text

  // Dados do signatario impressos no certificado
  signerName  String? @map("signer_name")
  signerTitle String? @map("signer_title")

  // Toggles
  showQrCode        Boolean @default(true) @map("show_qr_code")
  showValidationUrl Boolean @default(true) @map("show_validation_url")
  showSeal          Boolean @default(false) @map("show_seal")
  isActive          Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("certificate_templates")
}

// ============================================================
// CERTIFICADOS — EMITIDOS
// ============================================================

model Certificate {
  id   String @id @default(cuid())
  // Codigo curto para validacao publica (/validar/{code})
  code String @unique // ex: PMB-7K3X9A2

  studentId    String     @map("student_id")
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollmentId String     @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  courseId     String     @map("course_id")
  course       Course     @relation(fields: [courseId], references: [id])

  // tenantId = null indica certificado da vitrine PMB
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id])

  // Snapshot (nao muda se aluno trocar nome ou template mudar)
  studentName    String   @map("student_name")
  studentCpf     String?  @map("student_cpf")
  courseName     String   @map("course_name")
  cargaHoraria   String?  @map("carga_horaria")
  completionDate DateTime @map("completion_date")

  // Template usado (snapshot completo em JSON para regerar com mesma aparencia)
  templateSnapshot Json @map("template_snapshot")

  // PDF armazenado no Supabase Storage
  pdfUrl         String?   @map("pdf_url")
  pdfGeneratedAt DateTime? @map("pdf_generated_at")

  // Origem
  source         CertificateSource
  issuedByUserId String?           @map("issued_by_user_id")

  // Revogacao
  revokedAt     DateTime? @map("revoked_at")
  revokedReason String?   @map("revoked_reason")

  // Correcao de TITULARIDADE (certificado emitido no nome do responsavel em vez
  // do aluno). Reescreve o snapshot acima e mantem o mesmo `code`: trocar o
  // codigo faria /validar/{code} responder "nao encontrado" para quem conferisse
  // o codigo antigo — le como fraude. Ver src/lib/students/titularity/apply.ts.
  correctedAt       DateTime? @map("corrected_at")
  correctedByUserId String?   @map("corrected_by_user_id")
  correctionReason  String?   @map("correction_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([enrollmentId])
  @@index([tenantId, courseId])
  @@index([code])
  @@index([revokedAt])
  @@index([courseId], map: "certificates_course_id_idx")
  @@map("certificates")
}

/// Slides do banner principal (hero). tenantId=null => banner do site PMB
/// (singleton agregado); tenantId!=null => banner da vitrine daquele revendedor.
/// Cada slide carrega uma imagem desktop (1920x600) e uma mobile (1080x1080).
model BannerSlide {
  id         String   @id @default(cuid())
  tenantId   String?  @map("tenant_id")
  order      Int      @default(0)
  desktopUrl String   @map("desktop_url")
  mobileUrl  String   @map("mobile_url")
  linkUrl    String?  @map("link_url")
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, order])
  @@map("banner_slides")
}

/// Seções configuráveis da home. tenantId=null => config do site PMB
/// (fallback); tenantId!=null => config própria da vitrine daquela revenda.
/// `kind` controla qual renderer é usado; `config` é um JSON com shape
/// específico por kind (validado em src/lib/home/sections.ts).
model HomeSection {
  id        String   @id @default(cuid())
  tenantId  String?  @map("tenant_id")
  kind      String // "bestsellers" | "category_courses" | "categories_grid" | "institutional" | "tecnica" | "eja" | "idiomas"
  position  Int      @default(0)
  enabled   Boolean  @default(true)
  config    Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, position])
  @@map("home_sections")
}

// ============================================================
// AUTOMACAO — CRM Kanban de Leads B2C (aluno x curso x revenda)
// ============================================================
// Diferente de Lead (B2B — interessado em virar revendedor PMB), o
// StudentLead representa um aluno potencial de uma vitrine de revendedor.
// Originado por: formulario na pagina do curso, checkout iniciado, ou
// criacao manual no Kanban. Convertido em Student quando paga.

enum StudentLeadStage {
  NEW // Formulario preenchido na pagina do curso
  CONTACTED // Coluna manual: revendedor ja conversou
  CHECKOUT_STARTED // Iniciou checkout (gerou Enrollment PENDING)
  ABANDONED // Cron moveu apos N horas sem APPROVED
  WON // Pagamento APPROVED — convertido
  LOST // Manual: descartado
}

enum StudentLeadSource {
  FORM_COURSE // Form "Receba mais informacoes" na pagina do curso
  CHECKOUT_ABANDON // Criado direto pelo loja/checkout
  MANUAL // Revendedor adicionou na mao
}

enum StudentLeadActivityKind {
  STAGE_CHANGED // Mudanca de coluna (auto ou manual)
  WA_MESSAGE_SENT // Enviou template via engine WhatsApp
  WA_MESSAGE_FAILED // Engine rejeitou (nao conectado, numero invalido)
  NOTE // Anotacao manual do revendedor
  LEAD_CREATED // Origem (snapshot do source)
  ENROLLMENT_LINKED // Enrollment criada via checkout
  PAYMENT_APPROVED // Webhook MP aprovou
}

enum AutomationTemplateKey {
  FORM_SUBMITTED // Aluno preencheu form na pagina do curso
  CHECKOUT_ABANDONED // Carrinho abandonado (cron disparou)
  PURCHASE_CONFIRMED // Pagamento aprovado
  WELCOME // Boas vindas (manual/opcional)
}

model StudentLead {
  id       String  @id @default(cuid())
  // null = vitrine PMB institucional (sistema mae). Segue o padrao de
  // Enrollment/Payment/Coupon onde tenantId nullable indica venda PMB.
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Dados de contato (snapshot — nao FK pra Student; lead pode existir
  // antes de virar aluno, e podem ser duplicados ate convergirem).
  nome     String
  email    String
  telefone String // E.164 normalizado (ex: +5511999999999)
  notes    String? @db.Text

  // Curso de interesse — referencia ao Course (nao TenantCourse) por estabilidade:
  // tenant pode ocultar/remover TenantCourse sem perder a procedencia do lead.
  // courseId pode ser null pra leads adicionados manualmente sem curso especifico.
  courseId       String? @map("course_id")
  course         Course? @relation(fields: [courseId], references: [id])
  courseSnapshot String? @map("course_snapshot") // nome do curso no momento do lead

  // Pipeline
  stage  StudentLeadStage  @default(NEW)
  source StudentLeadSource @default(FORM_COURSE)

  // Quando ja existe enrollment vinculado (CHECKOUT_STARTED em diante).
  enrollmentId String?     @unique @map("enrollment_id")
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  // Quando vira WON, snapshot da venda.
  studentId    String?  @map("student_id")
  paymentValue Decimal? @map("payment_value") @db.Decimal(10, 2)

  // Atribuicao manual a um consultor (TenantMember).
  ownerUserId String? @map("owner_user_id")

  // Cookie do visitante anonimo (pmb_vid). Setado no momento da captura
  // (form ou checkout) e usado para herdar todo o historico de navegacao
  // (VisitorEvent) anterior e posterior a captura. Ver src/lib/automation/tracking.ts.
  visitorId String? @map("visitor_id")

  // Posicao livre dentro da coluna (drag-and-drop manual / re-ordenacao).
  columnOrder Int @default(0) @map("column_order")

  // LGPD / auditoria
  ipAddress       String? @map("ip_address")
  userAgent       String? @map("user_agent") @db.Text
  consentAccepted Boolean @default(false) @map("consent_accepted")
  consentVersion  String? @map("consent_version")

  activities    StudentLeadActivity[]
  visitorEvents VisitorEvent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([tenantId, stage, columnOrder])
  @@index([tenantId, createdAt])
  @@index([tenantId, source])
  @@index([enrollmentId])
  @@index([courseId])
  @@index([visitorId])
  @@map("student_leads")
}

model StudentLeadActivity {
  id     String      @id @default(cuid())
  leadId String      @map("lead_id")
  lead   StudentLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  kind     StudentLeadActivityKind
  // Texto livre exibido no historico. Para WA_MESSAGE_SENT, contem o corpo
  // efetivamente enviado (com variaveis ja interpoladas).
  body     String?                 @db.Text
  // Snapshot estruturado: { fromStage, toStage, templateKey, engineMessageId }
  metadata Json?

  // Author quando manual (NOTE, mudanca manual de stage). null = sistema.
  authorUserId String? @map("author_user_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([leadId, createdAt])
  @@map("student_lead_activities")
}

enum VisitorEventKind {
  PAGE_VIEW // Qualquer pagina da vitrine
  COURSE_VIEW // Pagina de detalhe de um curso (courseId resolvido)
}

// Trilha de navegacao do visitante (anonima ate a captura). Cada page view na
// vitrine gera um VisitorEvent identificado pelo cookie first-party pmb_vid
// (visitorId). Enquanto o visitante nao deixa contato, leadId fica null. No
// momento da captura (form na pagina do curso ou checkout) o sistema:
//   1. seta StudentLead.visitorId = pmb_vid
//   2. faz backfill: VisitorEvent.updateMany({ visitorId, leadId: null }) -> leadId
// herdando TODO o historico anterior. Eventos posteriores ja nascem com leadId
// preenchido (auto-atribuicao no endpoint de track), aparecendo na timeline do
// lead automaticamente. Gated por automationEnabled / pmbAutomationEnabled.
model VisitorEvent {
  id String @id @default(cuid())

  // null = vitrine PMB institucional (mesmo padrao de StudentLead).
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Cookie anonimo do navegador. Indexado para o backfill e a auto-atribuicao.
  visitorId String @map("visitor_id")

  // Preenchido quando o visitante ja virou (ou vira) lead. onDelete: SetNull
  // preserva o historico de navegacao mesmo se o lead for hard-deleted.
  leadId String?      @map("lead_id")
  lead   StudentLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  kind VisitorEventKind @default(PAGE_VIEW)

  // Caminho sem query string (LGPD — evita capturar PII em params).
  path  String
  title String?

  // Quando a pagina e de um curso, snapshot estavel para exibir na timeline.
  courseId       String? @map("course_id")
  course         Course? @relation(fields: [courseId], references: [id])
  courseSnapshot String? @map("course_snapshot")

  referrer String?

  createdAt DateTime @default(now()) @map("created_at")

  @@index([visitorId, createdAt])
  @@index([leadId, createdAt])
  @@index([tenantId, createdAt])
  @@index([courseId], map: "visitor_events_course_id_idx")
  @@map("visitor_events")
}

model AutomationMessageTemplate {
  id       String  @id @default(cuid())
  // null = templates da vitrine PMB institucional. Como o unique
  // composite (tenantId, key) nao dedupe com NULL no Postgres, o
  // sistema usa findFirst+create para inicializar templates PMB
  // em vez de upsert direto.
  tenantId String? @map("tenant_id")
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  key     AutomationTemplateKey
  // Corpo da mensagem com placeholders: {{aluno_nome}}, {{curso}}, {{escola}},
  // {{link_curso}}, {{valor}}. Renderizado em src/lib/automation/templates.ts.
  body    String                @db.Text
  enabled Boolean               @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, key])
  @@map("automation_message_templates")
}

// Trilha de auditoria persistente para ações sensíveis (block/unblock,
// impersonation, mudanças financeiras, alteração de permissão, exclusão de
// dados). Sem FKs de propósito: o registro deve sobreviver à exclusão do ator
// ou do recurso (imutabilidade forense / LGPD). Escrito por src/lib/audit.ts.
model AuditLog {
  id             String   @id @default(cuid())
  action         String
  resource       String
  resourceId     String?  @map("resource_id")
  actorUserId    String?  @map("actor_user_id")
  actorStudentId String?  @map("actor_student_id")
  actorRole      String   @map("actor_role")
  actorEmail     String?  @map("actor_email")
  tenantId       String?  @map("tenant_id")
  payloadBefore  Json?    @map("payload_before")
  payloadAfter   Json?    @map("payload_after")
  ip             String?
  userAgent      String?  @map("user_agent")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([actorUserId, createdAt])
  @@index([tenantId, createdAt])
  @@index([resource, resourceId])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// TREINAMENTOS — "Universidade PMB"
// Conteudo global (sem tenantId) criado pelo SUPER_ADMIN. Modulos agrupam
// videos (treinamentos) hospedados no YouTube. As unidades (RESELLER, dono +
// consultores) consultam pelo painel e marcam aulas como assistidas
// (TrainingProgress). Apenas modulos/videos `published` aparecem no painel.
// ============================================================

model TrainingModule {
  id          String  @id @default(cuid())
  title       String
  description String? @db.Text
  coverUrl    String? @map("cover_url")
  position    Int     @default(0)
  // Default true: módulo nasce visível para as unidades (vídeo já nasce
  // published=true). Migration 20260625 publica os módulos legados.
  published   Boolean @default(true)

  videos    TrainingVideo[]
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([position])
  @@map("training_modules")
}

model TrainingVideo {
  id            String  @id @default(cuid())
  moduleId      String  @map("module_id")
  title         String
  description   String? @db.Text
  // ID de 11 chars do YouTube (extraido da URL colada pelo admin).
  youtubeId     String  @map("youtube_id")
  // Duracao opcional digitada pelo admin (ex: "12:34") — exibida na lista.
  durationLabel String? @map("duration_label")
  position      Int     @default(0)
  published     Boolean @default(true)

  module   TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress TrainingProgress[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([moduleId, position])
  @@map("training_videos")
}

model TrainingProgress {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  videoId     String   @map("video_id")
  completedAt DateTime @default(now()) @map("completed_at")

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  video TrainingVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@index([userId])
  @@index([videoId], map: "training_progress_video_id_idx")
  @@map("training_progress")
}

// Banco de artes de divulgacao (global, sem tenantId — toda unidade consome o
// que estiver published). O arquivo base sobe SEM logo/telefone/valor; a
// personalizacao (logo no topo, rodape com site/whatsapp/rede social, badge de
// preco) e composta client-side no download (src/lib/artes/compose.ts).
model MarketingArt {
  id            String  @id @default(cuid())
  title         String
  // Categoria livre (string simples) — filtro no painel via DISTINCT.
  category      String?
  // Variante FEED (quadrada/4:5) — path no bucket vitrine-assets
  // (ex: "artes/<uuid>.png"), nunca URL completa.
  filePath      String  @map("file_path")
  width         Int
  height        Int
  // Variante STORIES (9:16, vertical) — opcional; quando presente a revenda
  // escolhe baixar feed, stories ou as duas.
  storyFilePath String? @map("story_file_path")
  storyWidth    Int?    @map("story_width")
  storyHeight   Int?    @map("story_height")
  // Arte de curso "com valor": a revenda digita o preco na hora de baixar.
  hasPrice      Boolean @default(false) @map("has_price")
  // Canto do topo onde o logo da revenda e carimbado: "top-left" | "top-right"
  // (string simples validada por Zod, mesmo padrao de Tenant.whatsappFloatSide).
  // LEGADO: usado so para derivar o layout default quando `layout` e null.
  logoCorner    String  @default("top-right") @map("logo_corner")
  // Posicoes/tamanhos definidos pelo designer por variante (ArtLayout em
  // src/lib/artes/types.ts): logo e preco arrastaveis + fundos brancos
  // opcionais. Null = defaults derivados de ART_ANCHORS + logoCorner.
  layout        Json?
  published     Boolean @default(true)
  position      Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([published, position])
  @@map("marketing_arts")
}

// ============================================================
// API DE PARCEIROS (/api/v1) — chaves de integracao
//
// Chave por SISTEMA INTEGRADO (nao por pessoa). O segredo completo so existe
// em texto puro no instante da criacao: guardamos apenas o SHA-256 dele, e a
// UI mostra o valor uma unica vez. Revogar um parceiro nao derruba os outros
// (era o problema de um segredo unico em env, no padrao CRON_SECRET).
//
// Formato do segredo: "pmb_live_<32 bytes em base64url>". O `prefix` guarda os
// primeiros caracteres para a UI identificar a chave ("pmb_live_a1b2c3d4…")
// sem nunca reter o segredo.
// ============================================================

model ApiKey {
  id   String @id @default(cuid())
  // Nome do sistema integrado ("CRM da rede", "ERP do contador"). So rotulo.
  name String

  // Primeiros chars do segredo — exibidos na listagem. Unique porque tambem
  // serve de identificador humano da chave nos logs.
  prefix  String @unique
  // SHA-256 (hex) do segredo completo. Unique => lookup O(1) por indice, sem
  // varrer a tabela comparando hash a hash. O segredo tem 256 bits de entropia,
  // entao hash rapido basta (nao e senha de humano, nao sofre ataque de dicionario).
  keyHash String @unique @map("key_hash")

  // Escopos concedidos (catalogo fechado em src/lib/api-parceiros/scopes.ts).
  // Chave sem o escopo exigido pela rota recebe 403.
  scopes String[] @default([])

  // ACTIVE | REVOKED. Revogar preserva a linha (trilha de auditoria);
  // nunca reaproveitamos o hash.
  status    String    @default("ACTIVE")
  revokedAt DateTime? @map("revoked_at")
  // Expiracao opcional. Null = nao expira.
  expiresAt DateTime? @map("expires_at")

  // Telemetria de uso — responde "esse integrador ainda esta chamando?" antes
  // de revogar. Atualizada best-effort (nunca derruba a resposta da API).
  lastUsedAt DateTime? @map("last_used_at")
  lastUsedIp String?   @map("last_used_ip")
  usageCount Int       @default(0) @map("usage_count")

  createdById String? @map("created_by_id")
  createdBy   User?   @relation("CreatedApiKeys", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@map("api_keys")
}
