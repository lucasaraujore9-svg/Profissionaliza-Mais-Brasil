# ============================================
# Profissionaliza Mais Brasil — Environment Variables
# Copie este arquivo para .env.local e preencha os valores
# ============================================

# App
NEXT_PUBLIC_APP_URL=https://profissionalizamaisbrasil.com.br
NEXT_PUBLIC_APP_DOMAIN=profissionalizamaisbrasil.com.br

# Database (Supabase — pegar em Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Supabase
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Para Next.js (variaveis publicas Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://[ID].upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://profissionalizamaisbrasil.com.br

# Escola Avancada API
EA_API_URL=https://SUAESCOLA.com/api/v2
EA_API_TOKEN=

# Asaas (usar sandbox para dev: https://api-sandbox.asaas.com/v3)
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Vercel (para gerenciar dominios custom dos revendedores)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Criptografia (gerar com: openssl rand -hex 32)
ENCRYPTION_KEY=

# Email — SMTP (Hostinger recomendado)
# Provedor principal. Se SMTP_* estiverem todos definidos, é usado.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@profissionalizamaisbrasil.com.br
SMTP_PASSWORD=
SMTP_FROM="Profissionaliza Mais Brasil <noreply@profissionalizamaisbrasil.com.br>"

# Email — Resend (fallback opcional, ignorado se SMTP_* estiverem setados)
RESEND_API_KEY=

# Cron Jobs (gerar com: openssl rand -hex 16)
CRON_SECRET=

# Internal API secret (para comunicacao middleware -> API)
INTERNAL_SECRET=
