# ============================================
# Profissionaliza Mais Brasil — Environment Variables
# Copie este arquivo para .env.local e preencha os valores.
# Fonte de verdade do schema/validação: src/lib/env.ts (Zod, fail-fast no boot).
# Mantenha este arquivo em sincronia com src/lib/env.ts.
# ============================================

# ── App / domínios ──────────────────────────────────────────────────────────
# APP_DOMAIN  = site institucional + admin + painel + aluno (apex).
# VITRINE_DOMAIN = domínio onde ficam *.${slug} das vitrines de revenda.
NEXT_PUBLIC_APP_URL=https://profissionalizamaisbrasil.com.br
NEXT_PUBLIC_APP_DOMAIN=profissionalizamaisbrasil.com.br
NEXT_PUBLIC_VITRINE_DOMAIN=livrecursos.com.br

# ── Database (Supabase — Settings > Database > Connection string) ────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
# Tuning opcional do pool pg (default 10). Aumentar só sob carga real.
DATABASE_POOL_MAX=10

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role = poder total no Storage/DB. SOMENTE server-side. Nunca exponha.
SUPABASE_SERVICE_ROLE_KEY=
# ATENÇÃO: SUPABASE_ACCESS_TOKEN é um Personal Access Token de ADMIN, usado
# apenas localmente pelo MCP (.mcp.json). NÃO defina como env de runtime na
# Vercel — daria poder de admin do projeto ao runtime da aplicação.
SUPABASE_ACCESS_TOKEN=

# Variáveis públicas Supabase (expostas ao client). A anon key não é usada
# atualmente em nenhum componente client (acesso ao banco é só via Prisma).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Redis (Upstash) — cache de tenant + rate limiting ────────────────────────
# Sem Redis em PRODUÇÃO: o rate-limit faz FAIL-CLOSED (nega tráfego nas rotas
# protegidas) e assertEnv emite warning. Em dev, fail-open (libera).
UPSTASH_REDIS_REST_URL=https://[ID].upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Auth (NextAuth v5) ───────────────────────────────────────────────────────
# Prefira AUTH_SECRET (nome oficial v5). NEXTAUTH_SECRET é aceito por legado.
# Obrigatório em produção (assertEnv lança sem ele). >= 32 chars.
# Gere com: openssl rand -hex 32
AUTH_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://profissionalizamaisbrasil.com.br

# ── Criptografia (AES-256-GCM p/ mpAccessToken dos tenants) ──────────────────
# 64 chars hex (= 32 bytes). Gere com: openssl rand -hex 32
ENCRYPTION_KEY=

# ── Plataforma parceira (API form-data) ─────────────────────────────────────
EA_API_URL=https://SUAESCOLA.com/api/v2
EA_API_TOKEN=
# URL pública do portal do aluno (botão "Acessar aulas"). Mesmo link para todos.
EA_STUDENT_LOGIN_URL=https://playcurso.com/bolsamaisbrasil/metodo/login.php

# ── Nova fornecedora LMS (API REST JSON, M2M) ───────────────────────────────
# Catálogo, matrícula, SSO e delta sync da fornecedora própria (provider=LMS).
LMS_API_URL=https://lms.bmbr.com.br
LMS_API_KEY=
# HMAC SHA256 do receiver de webhook LMS→PMB (POST /api/webhooks/lms). Sem ele
# em PRODUÇÃO o receiver responde 503 (certificado/progresso/suporte do LMS não
# chegam). O lado LMS precisa assinar com este MESMO segredo. >=16 chars.
PMB_WEBHOOK_SECRET=

# ── Asaas (cobrança de revendedores) — sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
# Token validado no header do webhook Asaas (obrigatório em prod, >=16 chars).
ASAAS_WEBHOOK_TOKEN=

# ── Mercado Pago (webhook) ───────────────────────────────────────────────────
# HMAC SHA256 do webhook MP. Sem ele em PRODUÇÃO os webhooks MP são REJEITADOS
# (sem matrícula automática). Configure no painel MP + aqui. >=16 chars.
MP_WEBHOOK_SECRET=
# Dev-only: pula a verificação HMAC do webhook MP em ambiente local. NUNCA em prod.
MP_WEBHOOK_DEV_BYPASS=

# Tokens MP dos revendedores são por tenant (criptografados no banco) — não vão aqui.

# ── Vitrine PMB (vendas diretas, tenantId=null) ──────────────────────────────
PMB_MP_ACCESS_TOKEN=
# Public key MP da vitrine PMB (Checkout Transparente / Payment Brick).
PMB_MP_PUBLIC_KEY=
PMB_PLATAFORMA_VENDEDOR_ID=
PMB_PLATAFORMA_POLO=
PMB_EA_VENDEDOR_ID=
PMB_EA_POLO=
PMB_SUPPORT_EMAIL=

# ── Vercel (gerencia DNS de custom domains dos revendedores) ─────────────────
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# IP do apex p/ custom domains (Registro.br não aceita CNAME em @). Opcional —
# default em lib/tenant/urls.ts (vercelApexIp()). Só setar p/ sobrescrever.
VERCEL_APEX_IP=

# ── Email — SMTP (Hostinger) preferido; Resend é fallback ────────────────────
# O domínio do SMTP_FROM precisa bater com o do SMTP_USER (SPF/DKIM).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=nao-responda@profissionalizamaisbrasil.com.br
SMTP_PASSWORD=
SMTP_FROM="Profissionaliza Mais Brasil <nao-responda@profissionalizamaisbrasil.com.br>"
# Fallback opcional (ignorado se SMTP_* estiverem setados)
RESEND_API_KEY=

# ── Cron Jobs / Interno ──────────────────────────────────────────────────────
# Obrigatórios em prod (>=32 chars). Gere com: openssl rand -hex 32
CRON_SECRET=
# Secret da comunicação proxy -> /api/internal/*
INTERNAL_SECRET=

# ── WhatsApp Gateway (automação / módulo WAHA) ───────────────────────────────
WA_GATEWAY_URL=
WA_GATEWAY_API_KEY=

# ── Web Push (VAPID) — opcional ──────────────────────────────────────────────
# Sem essas vars o botão "ativar notificações do navegador" fica desabilitado.
# VAPID_PUBLIC_KEY é exposto ao client via /api/push/public-key.
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@profissionalizamaisbrasil.com.br

# ── Observabilidade (opcional — fan-out HTTP direto pro Axiom) ───────────────
LOG_LEVEL=info
AXIOM_TOKEN=
AXIOM_DATASET=
AXIOM_URL=

# ── Links públicos (rodapé / contato) — opcionais ────────────────────────────
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_HOURS=
NEXT_PUBLIC_SUPPORT_WHATSAPP=
