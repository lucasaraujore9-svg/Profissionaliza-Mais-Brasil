# ============================================
# Profissionaliza Mais Brasil — Environment Variables
# Copie este arquivo para .env.local e preencha os valores
# ============================================

# App
# APP_DOMAIN  = dominio do site institucional + admin + painel (apex sem subdominio).
# VITRINE_DOMAIN = dominio onde ficam *.${slug} das vitrines de revenda.
# Sao dominios distintos: ninguem acessa vitrine em APP_DOMAIN, ninguem acessa admin/painel em VITRINE_DOMAIN.
NEXT_PUBLIC_APP_URL=https://profissionalizamaisbrasil.com.br
NEXT_PUBLIC_APP_DOMAIN=profissionalizamaisbrasil.com.br
NEXT_PUBLIC_VITRINE_DOMAIN=livrecursos.com.br

# Database (Supabase — pegar em Settings > Database > Connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Supabase
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# Para Next.js (variaveis publicas Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://[ID].upstash.io
UPSTASH_REDIS_REST_TOKEN=

# Auth
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://profissionalizamaisbrasil.com.br

# plataforma parceira API
EA_API_URL=https://SUAESCOLA.com/api/v2
EA_API_TOKEN=

# Asaas (usar sandbox para dev: https://api-sandbox.asaas.com/v3)
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# Vercel (para gerenciar dominios custom dos revendedores)
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Criptografia (gerar com: openssl rand -hex 32)
ENCRYPTION_KEY=

# Email — SMTP (Hostinger)
# Provedor principal. Se SMTP_* estiverem todos definidos, é usado.
# Importante: o domínio do SMTP_FROM precisa bater com o do SMTP_USER
# (mesmo domínio autenticado) para passar SPF/DKIM.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=profissionaliza@bmbr.com.br
SMTP_PASSWORD=
SMTP_FROM="Profissionaliza Mais Brasil <profissionaliza@bmbr.com.br>"

# Email — Resend (fallback opcional, ignorado se SMTP_* estiverem setados)
RESEND_API_KEY=

# Cron Jobs (gerar com: openssl rand -hex 16)
CRON_SECRET=

# Internal API secret (para comunicacao middleware -> API)
INTERNAL_SECRET=

# Web Push (VAPID) — gerar com: npx web-push generate-vapid-keys
# Sem essas variaveis o botao "ativar notificacoes do navegador" fica desabilitado
# (o resto do app — sininho, som, in-app — continua funcionando).
# VAPID_PUBLIC_KEY  e exposto ao client via /api/push/public-key
# VAPID_SUBJECT     = mailto:... (RFC 8292) — push services contatam aqui em caso de erro
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@profissionalizamaisbrasil.com.br
